# =============================================================================
# Meetifyy — environment overview
# =============================================================================
# This repository is a monorepo with three deployable apps, each with its own
# environment file. This file is a MAP, not a file to copy wholesale:
#
#   backend/.env.example         → NestJS API   (server-only, runtime)
#   frontend/.env.example        → main web app (public, BUILD-time)
#   admin-frontend/.env.example  → admin web app(public, BUILD-time)
#
# Full reference: the annotated per-app templates listed above.
#
# -----------------------------------------------------------------------------
# The rule
# -----------------------------------------------------------------------------
# Environment-specific values belong in configuration, not application code.
# The same git commit is deployed to every environment; what differs is only the
# environment variables it is given.
#
#   Development  → .env.development  → dev database, dev domains, Mailpit
#   Staging      → platform env vars → staging database, staging domains
#   Production   → platform env vars → prod database, prod domains, Resend
#
# -----------------------------------------------------------------------------
# Getting started locally
# -----------------------------------------------------------------------------
#   cp backend/.env.example        backend/.env.local
#   cp frontend/.env.example       frontend/.env.local
#   cp admin-frontend/.env.example admin-frontend/.env.local
#   # fill in credentials, then:
#   npm run dev
#
# -----------------------------------------------------------------------------
# Which file is read where
# -----------------------------------------------------------------------------
# Backend (loaded by src/config/env.ts, first hit wins):
#   process env → .env.<APP_ENV>.local → .env.local → .env.<APP_ENV> → .env
#
# Frontend / admin (loaded by Vite, first hit wins):
#   .env.<mode>.local → .env.local → .env.<mode> → .env
#
# -----------------------------------------------------------------------------
# Public vs private
# -----------------------------------------------------------------------------
# Every VITE_* variable is inlined into the browser bundle at build time and is
# therefore PUBLIC and BUILD-TIME. Changing one has no effect until a rebuild.
#
# These must NEVER appear in a frontend env file:
#   DATABASE_URL, DIRECT_URL
#   SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET
#   ADMIN_JWT_*_SECRET, SUPER_ADMIN_PASSWORD, SUPER_ADMIN_API_KEY
#   RESEND_API_KEY, SMTP_PASS
#   R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
#
# -----------------------------------------------------------------------------
# Never commit real values
# -----------------------------------------------------------------------------
# .gitignore excludes every .env* file except the *.example templates.
# Developer-specific files (.env.local, .env.development.local) stay local.

# ── Support desk ─────────────────────────────────────────────────────────────
# Optional Reply-To header on outgoing support mail (default: omitted).
# All support mail is sent from noreply@meetifyy.app.
#
# New support requests are NOT emailed anywhere internally. They appear in the
# Support section of the Admin Dashboard.
SUPPORT_REPLY_TO=

# Salt for the one-way hash of a submitter's IP address. The raw address is
# never stored. Falls back to SUPABASE_JWT_SECRET, then ADMIN_JWT_ACCESS_SECRET,
# so this only needs setting to rotate it independently of those.
SUPPORT_IP_HASH_SALT=

# ── Application monitoring ───────────────────────────────────────────────────
# Admin -> Monitoring. Application-level observability only; the hosting
# platform still owns infrastructure logs and metrics.
#
# Promoting this feature between environments is a change of VALUES here, never
# a change of code. See MONITORING.md for the full table and for which of these
# typically differ in production.

# Master switch for collection. The admin API still serves history when off.
MONITORING_ENABLED=true

# Fraction of SUCCESSFUL requests recorded, 0 to 1. Errors and slow requests
# always bypass sampling. Lower this in production (e.g. 0.2).
LOG_SAMPLE_RATE=1.0

# Requests at or above this duration are always recorded, whatever the sample rate.
SLOW_REQUEST_MS=1000

# How often a system snapshot (memory, CPU, event loop lag, DB pool, sockets)
# is taken.
METRICS_INTERVAL_MS=15000

# Buffered writes, so logging never blocks a response. The buffer is capped and
# drops oldest-first if the database is unreachable.
MONITORING_FLUSH_INTERVAL_MS=5000
MONITORING_FLUSH_BATCH_SIZE=50
MONITORING_MAX_BUFFERED_ROWS=5000

# Retention. Rows older than this are deleted on the interval below.
LOG_RETENTION_DAYS=14
LOG_RETENTION_INTERVAL_MS=21600000

# Whether stack traces are stored on error rows. Admin-only on read.
LOG_STACK_TRACES=false

# Extra field names to redact, comma-separated. MERGED WITH a built-in denylist
# (authorization, cookie, password, token, secret, otp, ...) - setting this can
# only add to that list, never shrink it.
REDACT_FIELDS=

# Route prefixes never recorded. Defaults keep monitoring from logging its own
# reads.
MONITORING_IGNORED_ROUTES=

# Dashboard behaviour, served to the client so the cadence lives in one place.
MONITORING_POLLING_INTERVAL_MS=15000
MONITORING_PAGE_SIZE=50

# Per-admin budget for the monitoring API. These are the most expensive queries
# in the app and the dashboard polls them.
MONITORING_RATE_LIMIT_POINTS=120
MONITORING_RATE_LIMIT_WINDOW_SEC=60

# Thresholds above which the dashboard shows "Degraded".
MONITORING_ERROR_RATE_WARNING=5
MONITORING_LATENCY_WARNING_MS=800

# Free-text label shown on the status card. DISPLAY ONLY - never read for a
# decision, so it cannot become an environment branch by the back door.
MONITORING_ENVIRONMENT_LABEL=
