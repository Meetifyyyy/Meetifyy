# =============================================================================
# Meetifyy — environment overview
# =============================================================================
# This repository is a monorepo with three deployable apps, each with its own
# environment file. This file is a MAP, not a file to copy wholesale:
#
#   backend/.env.example         → NestJS API   (server-only, runtime)
#   frontend/.env.example        → main web app (public, BUILD-time)
#   admin-frontend/.env.example  → admin web app(public, BUILD-time)
#
# Full reference: the annotated per-app templates listed above.
#
# -----------------------------------------------------------------------------
# The rule
# -----------------------------------------------------------------------------
# Environment-specific values belong in configuration, not application code.
# The same git commit is deployed to every environment; what differs is only the
# environment variables it is given.
#
#   Development  → .env.development  → dev database, dev domains, Mailpit
#   Staging      → platform env vars → staging database, staging domains
#   Production   → platform env vars → prod database, prod domains, Resend
#
# -----------------------------------------------------------------------------
# Getting started locally
# -----------------------------------------------------------------------------
#   cp backend/.env.example        backend/.env.local
#   cp frontend/.env.example       frontend/.env.local
#   cp admin-frontend/.env.example admin-frontend/.env.local
#   # fill in credentials, then:
#   npm run dev
#
# -----------------------------------------------------------------------------
# Which file is read where
# -----------------------------------------------------------------------------
# Backend (loaded by src/config/env.ts, first hit wins):
#   process env → .env.<APP_ENV>.local → .env.local → .env.<APP_ENV> → .env
#
# Frontend / admin (loaded by Vite, first hit wins):
#   .env.<mode>.local → .env.local → .env.<mode> → .env
#
# -----------------------------------------------------------------------------
# Public vs private
# -----------------------------------------------------------------------------
# Every VITE_* variable is inlined into the browser bundle at build time and is
# therefore PUBLIC and BUILD-TIME. Changing one has no effect until a rebuild.
#
# These must NEVER appear in a frontend env file:
#   DATABASE_URL, DIRECT_URL
#   SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET
#   ADMIN_JWT_*_SECRET, SUPER_ADMIN_PASSWORD, SUPER_ADMIN_API_KEY
#   RESEND_API_KEY, SMTP_PASS
#   R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
#
# -----------------------------------------------------------------------------
# Never commit real values
# -----------------------------------------------------------------------------
# .gitignore excludes every .env* file except the *.example templates.
# Developer-specific files (.env.local, .env.development.local) stay local.

# ── Support desk ─────────────────────────────────────────────────────────────
# Optional Reply-To header on outgoing support mail (default: omitted).
# All support mail is sent from noreply@meetifyy.app.
#
# New support requests are NOT emailed anywhere internally. They appear in the
# Support section of the Admin Dashboard.
SUPPORT_REPLY_TO=

# Salt for the one-way hash of a submitter's IP address. The raw address is
# never stored. Falls back to SUPABASE_JWT_SECRET, then ADMIN_JWT_ACCESS_SECRET,
# so this only needs setting to rotate it independently of those.
SUPPORT_IP_HASH_SALT=

# ── Slow-request capture ─────────────────────────────────────────────────────
# Admin -> Analytics. Records requests that exceed a latency threshold, measured
# server-side around the real request lifecycle. There is no sampling and no
# client-reported timing.
#
# Promoting this between environments is a change of VALUES here, never a change
# of code.

# Master switch. Off stops new rows; the retention sweep still runs.
SLOW_REQUEST_CAPTURE_ENABLED=true

# A request at or above this many milliseconds is recorded.
SLOW_REQUEST_THRESHOLD_MS=500

# Rolling retention window. Rows older than this are deleted by the sweep.
SLOW_REQUEST_RETENTION_DAYS=7

# Write ceiling. A total outage makes every request slow; without a cap the
# first minutes of an incident would write a row per request. Excess is counted
# and logged, never stored.
SLOW_REQUEST_MAX_PER_MINUTE=120

# Comma-separated prefixes never recorded. Defaults keep the analytics page from
# recording its own reads.
SLOW_REQUEST_IGNORED_PREFIXES=

# ── Analytics probes ─────────────────────────────────────────────────────────
# Admin -> Analytics reports live infrastructure usage. Every panel is measured
# by calling the service itself, so which transport or provider is reported
# follows the variables below - production needs no code change.

# Ceiling on any single outbound probe before it counts as unavailable.
ANALYTICS_PROBE_TIMEOUT_MS=4000

# Path prefix that marks a request as admin-portal traffic. The slow-request
# table reports admin and public-app traffic as separate sections, because a
# latency that is routine on one is a regression on the other.
ANALYTICS_ADMIN_ROUTE_PREFIX=/admin

# Cap on the R2 listing used to total stored bytes (1,000 objects per page).
# Beyond this the figure is reported as a partial scan.
ANALYTICS_R2_MAX_LIST_PAGES=20

# Resend API root. The probe performs an authenticated read beneath this, which
# verifies both reachability and that the key is accepted. Override only for a
# proxy or a pinned API version.
RESEND_API_URL=https://api.resend.com

# ── Infrastructure usage providers (optional) ────────────────────────────────
# Each panel appears once its credentials are present. While they are absent the
# provider is listed as "not reporting" - it is never shown as zero usage.

# Cloudflare R2 Class A / Class B operation counts and billing analytics. The R2
# S3 keys above cannot read these; this needs an API token with
# Account Analytics: Read. Account ID falls back to R2_ACCOUNT_ID.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Vercel usage against the current plan's limits.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Azure spend and remaining credit. Needs a service principal with the
# Cost Management Reader role on the subscription. Note that a credit BALANCE is
# only exposed for agreement types that have one (MCA / EA / sponsorship);
# pay-as-you-go reports spend only.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
