# ==============================================================================
# Meetifyy Monorepo .gitignore
# Comprehensive rules for Frontend (Vite/React), Backend (NestJS/Prisma),
# Admin Frontend, Local Tooling, Caches, Secrets, and OS/IDE files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependency Directories
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 2. Build & Production Outputs
# ------------------------------------------------------------------------------
dist/
build/
out/
output/
dist-ssr/
**/dist/
**/build/
**/output/
**/dist-ssr/
*.tsbuildinfo
.next/
.nuxt/
.output/

# ------------------------------------------------------------------------------
# 3. Cache & Framework Temporary Directories
# ------------------------------------------------------------------------------
.cache/
**/.cache/
.vite/
**/.vite/
.turbo/
**/.turbo/
.eslintcache
.stylelintcache
.parcel-cache/
.rollup.cache/
.swc/
**/node_modules/.cache/

# ------------------------------------------------------------------------------
# 4. Environment Variables, Local Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*.local

# Whitelist safe example / template configs
!.env.example
!*.env.example
!.env.template
!*.env.template
!backend/.env.example
!frontend/.env.example
!admin-frontend/.env.example

# ------------------------------------------------------------------------------
# 5. Local Development Runtime, Scripts & Playgrounds
# ------------------------------------------------------------------------------
local/
**/local/
start.sh
start.bat
plan.md
.cloudflared
.mobile-url.txt
mobile-qr.png

# Local notification / debug playground components (development-only)
frontend/src/local/
admin-frontend/src/local/
backend/src/local/
**/src/local/
**/src/dev/

# ------------------------------------------------------------------------------
# 6. Database, SQLite & Local Prisma Artifacts
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite-journal
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal
/backend/generated/prisma
backend/prisma/*.db
backend/prisma/*.db-journal

# ------------------------------------------------------------------------------
# 7. Local Media, Uploads & Temporary Scratchpads
# ------------------------------------------------------------------------------
uploads/
**/uploads/
tmp/
temp/
scratch/
**/*.tmp
**/*.temp

# ------------------------------------------------------------------------------
# 8. Testing, Coverage & E2E Artifacts
# ------------------------------------------------------------------------------
coverage/
**/coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/
testmail/

# ------------------------------------------------------------------------------
# 9. Logs & Runtime Diagnostics
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Visualizer & Bundle Audit Reports
stats.html
**/stats.html
report.html
**/report.html

# ------------------------------------------------------------------------------
# 10. OS & Machine-Specific Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 11. IDEs, Editors & AI Agent Metadata (Never Committed)
# ------------------------------------------------------------------------------
.vscode/
.idea/
.vs/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
*.bak
*.orig
*.rej
.project
.settings/
.claude/
.gemini/
.agent/
.agents/
.dual-graph/
AGENTS.md
GEMINI.md
skills-lock.json
REMEDIATION_PLAN.md
meetifyy-security-remediation-report.md

# ------------------------------------------------------------------------------
# 12. Documentation & Temporary Audit Scripts
# ------------------------------------------------------------------------------
# Scratch docs and audit output stay out of the repo, but two are durable
# engineering references and are tracked explicitly. A negation cannot re-include
# a file whose parent directory is excluded, hence `docs/*` rather than `docs/`.
docs/*
!docs/network-reachability.md
!docs/verification-checklist.md
diff_*.txt
all_files.txt
git_files.txt
git_untracked.txt
*files_utf8.txt
check_*.ts
test_*.ts
remove_*.ts
update_*.ts
inspect_*.ts
send_*.ts
test_svc.ts

# Mailpit binary (dev-only, not committed)
local/bin/mailpit
