# ==============================================================================
# Meetifyy Monorepo .gitignore
# Comprehensive rules for Frontend (Vite/React), Backend (NestJS/Prisma),
# Admin Frontend, Local Tooling, Caches, Secrets, and OS/IDE files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependency Directories
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 2. Build & Production Outputs
# ------------------------------------------------------------------------------
dist/
build/
out/
output/
dist-ssr/
**/dist/
**/build/
**/output/
**/dist-ssr/
*.tsbuildinfo
.next/
.nuxt/
.output/

# ------------------------------------------------------------------------------
# 3. Cache & Framework Temporary Directories
# ------------------------------------------------------------------------------
.cache/
**/.cache/
.vite/
**/.vite/
.turbo/
**/.turbo/
.eslintcache
.stylelintcache
.parcel-cache/
.rollup.cache/
.swc/
**/node_modules/.cache/

# ------------------------------------------------------------------------------
# 4. Environment Variables, Local Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*.local

# Whitelist safe example / template configs
!.env.example
!*.env.example
!.env.template
!*.env.template
!backend/.env.example
!frontend/.env.example
!admin-frontend/.env.example
# Per-environment templates (placeholders only — never real values)
!.env.*.example
!*/.env.*.example

# ------------------------------------------------------------------------------
# 5. Local Development Runtime, Scripts & Playgrounds
# ------------------------------------------------------------------------------
local/
**/local/
start.sh
start.bat
plan.md
.cloudflared
.mobile-url.txt
mobile-qr.png

# Local notification / debug playground components (development-only)
frontend/src/local/
admin-frontend/src/local/
backend/src/local/
**/src/local/
**/src/dev/

# ------------------------------------------------------------------------------
# 6. Database, SQLite & Local Prisma Artifacts
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite-journal
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal
/backend/generated/prisma
backend/prisma/*.db
backend/prisma/*.db-journal

# ------------------------------------------------------------------------------
# 7. Local Media, Uploads & Temporary Scratchpads
# ------------------------------------------------------------------------------
uploads/
**/uploads/
# ...but backend/src/uploads is the storage MODULE, not an upload directory.
# The rule above silently swallowed every new file added there — its existing
# files are only tracked because they predate the rule, and anything added
# since had to be force-added or was quietly lost.
!backend/src/uploads/
!backend/src/uploads/**
tmp/
temp/
scratch/
**/*.tmp
**/*.temp

# ------------------------------------------------------------------------------
# 8. Testing, Coverage & E2E Artifacts
# ------------------------------------------------------------------------------
coverage/
**/coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/
testmail/

# ------------------------------------------------------------------------------
# 9. Logs & Runtime Diagnostics
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Visualizer & Bundle Audit Reports
stats.html
**/stats.html
report.html
**/report.html

# ------------------------------------------------------------------------------
# 10. OS & Machine-Specific Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 11. IDEs, Editors & AI Agent Metadata (Never Committed)
# ------------------------------------------------------------------------------
.vscode/
.idea/
.vs/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
*.bak
*.orig
*.rej
.project
.settings/
.claude/
.gemini/
.agent/
.agents/
.dual-graph/
AGENTS.md
GEMINI.md
skills-lock.json
REMEDIATION_PLAN.md
meetifyy-security-remediation-report.md

# ------------------------------------------------------------------------------
# 12. Documentation & Temporary Audit Scripts
# ------------------------------------------------------------------------------
# Scratch docs and audit output stay out of the repo, but two are durable
# engineering references and are tracked explicitly. A negation cannot re-include
# a file whose parent directory is excluded, hence `docs/*` rather than `docs/`.
docs/*
!docs/network-reachability.md
!docs/verification-checklist.md
!docs/production-azure-setup-guide.md
diff_*.txt
all_files.txt
git_files.txt
git_untracked.txt
*files_utf8.txt
check_*.ts
test_*.ts
remove_*.ts
update_*.ts
inspect_*.ts
send_*.ts
test_svc.ts

# Mailpit binary (dev-only, not committed)
local/bin/mailpit

# ------------------------------------------------------------------------------
# 13. Generated Build Metadata
# ------------------------------------------------------------------------------
# `versionBuildPlugin` in frontend/vite.config.js rewrites version.json on every
# `buildStart`, so it changes on each build and conflicts on every merge while
# carrying no information a build cannot regenerate. It is currently TRACKED —
# this rule only stops it coming back after `git rm --cached`.
frontend/public/version.json
**/public/version.json

# vite-plugin-pwa's development output. Named dev-dist, so the dist/ rules above
# do not cover it.
dev-dist/
**/dev-dist/

# ------------------------------------------------------------------------------
# 14. Keys, Certificates & Service Credentials
# ------------------------------------------------------------------------------
# Section 4 keeps .env files out; these are the credential formats that arrive as
# their own files instead — a downloaded service account, a local TLS cert, an
# Android signing keystore. None belong in a repo, and a leak here is worse than
# a leak of source.
*.pem
*.key
*.crt
*.cer
*.der
*.pfx
*.p12
*.jks
*.keystore
secrets/
**/secrets/
*service-account*.json
gha-creds-*.json

# ------------------------------------------------------------------------------
# 15. Additional Editor, AI Assistant & Tooling Metadata
# ------------------------------------------------------------------------------
# Section 11 covers the editors this project has met so far; these are the rest,
# listed so a teammate on a different setup cannot commit their local config.
.history/
.cursor/
.cursorrules
.windsurf/
.windsurfrules
.zed/
.fleet/
.continue/
.aider*
.sourcegraph/
*.code-workspace

# ------------------------------------------------------------------------------
# 16. Process, Cache & Packaging Leftovers
# ------------------------------------------------------------------------------
*.pid
*.pid.lock
*.seed
.vitest/
**/.vitest/
.jest-cache/
**/.jest-cache/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz
*.tgz
*.tar.gz
*.zip
*.7z
*.rar

# Throwaway scripts written beside the code they probe. `**/*.tmp` above catches
# the .tmp suffix; this catches the .tmp- prefix convention, which is what a
# one-off db check or migration probe tends to be called.
.tmp-*
**/.tmp-*

# Extra OS leftovers not covered in section 10.
.AppleDouble
.LSOverride
Thumbs.db:encryptable

# ------------------------------------------------------------------------------
# 17. Python, Scratch Scripts & Temporary Files
# ------------------------------------------------------------------------------
*.py
*.pyc
*.pyo
*.pyd
__pycache__/
**/__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/
env/

# Scratch & temporary workspace directories
scratch/
**/scratch/
temp/
**/temp/
tmp/
**/tmp/
brain/
**/.system_generated/

# Scratch script patterns
scratch_*
scratch.*
*.scratch.*
*.scratch
temp_*
tmp_*
test_*.py
scratch_*.py
test_script*

# Scratch & temporary Markdown notes (preserves tracked durable documentation)
scratch*.md
**/scratch*.md
temp*.md
**/temp*.md
tmp*.md
**/tmp*.md
AUDIT*.md
audit_*.md
NOTES*.md
notes.md
*notes*.md
TODO*.md
todo*.md
walkthrough*.md
implementation_plan*.md
task*.md
plan*.md
scratch_*.md
test_*.md

# Database dumps & backup files
*.dump
*.sql.bak
*.sql.gz
*.sqlite
*.sqlite3
*.db
