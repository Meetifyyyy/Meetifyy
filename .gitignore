# ==============================================================================
# Meetifyy Monorepo .gitignore
# Comprehensive rules for Frontend (Vite/React), Backend (NestJS/Prisma),
# Admin Frontend, Local Tooling, Caches, Secrets, and OS/IDE files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependency Directories
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 2. Build & Production Outputs
# ------------------------------------------------------------------------------
dist/
# The mobile build target's output. `dist/` above is a literal directory name,
# so a sibling with a different name needs its own entry.
dist-mobile/
**/dist-mobile/
build/
out/
output/
dist-ssr/
**/dist/
**/build/
**/output/
**/dist-ssr/
*.tsbuildinfo
.next/
.nuxt/
.output/

# ------------------------------------------------------------------------------
# 3. Cache & Framework Temporary Directories
# ------------------------------------------------------------------------------
.cache/
**/.cache/
.vite/
**/.vite/
.turbo/
**/.turbo/
.eslintcache
.stylelintcache
.parcel-cache/
.rollup.cache/
.swc/
**/node_modules/.cache/

# ------------------------------------------------------------------------------
# 4. Environment Variables, Local Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*.local

# Whitelist safe example / template configs
!.env.example
!*.env.example
!.env.template
!*.env.template
!backend/.env.example
!frontend/.env.example
!admin-frontend/.env.example
# Per-environment templates (placeholders only — never real values)
!.env.*.example
!*/.env.*.example

# ------------------------------------------------------------------------------
# 5. Local Development Runtime, Scripts & Playgrounds
# ------------------------------------------------------------------------------
local/
**/local/
start.sh
start.bat
plan.md
.cloudflared
.mobile-url.txt
mobile-qr.png

# Local notification / debug playground components (development-only)
frontend/src/local/
admin-frontend/src/local/
backend/src/local/
**/src/local/
**/src/dev/

# ------------------------------------------------------------------------------
# 6. Database, SQLite & Local Prisma Artifacts
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite-journal
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal
/backend/generated/prisma
backend/prisma/*.db
backend/prisma/*.db-journal

# ------------------------------------------------------------------------------
# 7. Local Media, Uploads & Temporary Scratchpads
# ------------------------------------------------------------------------------
uploads/
**/uploads/
# ...but backend/src/uploads is the storage MODULE, not an upload directory.
# The rule above silently swallowed every new file added there — its existing
# files are only tracked because they predate the rule, and anything added
# since had to be force-added or was quietly lost.
!backend/src/uploads/
!backend/src/uploads/**
tmp/
temp/
scratch/
**/*.tmp
**/*.temp

# ------------------------------------------------------------------------------
# 8. Testing, Coverage & E2E Artifacts
# ------------------------------------------------------------------------------
coverage/
**/coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/
testmail/

# ------------------------------------------------------------------------------
# 9. Logs & Runtime Diagnostics
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Visualizer & Bundle Audit Reports
stats.html
**/stats.html
report.html
**/report.html

# ------------------------------------------------------------------------------
# 10. OS & Machine-Specific Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 11. IDEs, Editors & AI Agent Metadata (Never Committed)
# ------------------------------------------------------------------------------
.vscode/
.idea/
.vs/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
*.bak
*.orig
*.rej
.project
.settings/
.claude/
.gemini/
.agent/
.agents/
.dual-graph/
AGENTS.md
CLAUDE.md
GEMINI.md
skills-lock.json
REMEDIATION_PLAN.md
meetifyy-security-remediation-report.md

# ------------------------------------------------------------------------------
# 12. Documentation & Temporary Audit Scripts
# ------------------------------------------------------------------------------
# Scratch docs and audit output stay out of the repo; the durable references
# below are tracked explicitly. A negation cannot re-include a file whose parent
# directory is excluded, hence `docs/*` rather than `docs/`.
#
# NOTE: a new durable doc MUST be added here or `git add` skips it silently —
# `git add -A` reports nothing and the commit simply lacks the file. That is how
# docs/rate-limiting.md was first committed as a README link pointing at a file
# that was never pushed.
docs/*
!docs/techstack.md
!docs/project-structure.md
!docs/azure-setup.md
!docs/operations.md
!docs/rate-limiting.md
!docs/first-year-isolation.md
!docs/testing-log.md
!docs/mobile-auth-decision.md

diff_*.txt
all_files.txt
git_files.txt
git_untracked.txt
*files_utf8.txt
check_*.ts
test_*.ts
remove_*.ts
update_*.ts
inspect_*.ts
send_*.ts
test_svc.ts

# Mailpit binary (dev-only, not committed)
local/bin/mailpit


# vite-plugin-pwa's development output. Named dev-dist, so the dist/ rules above
# do not cover it.
dev-dist/
**/dev-dist/

# ------------------------------------------------------------------------------
# 13b. Capacitor native projects
# ------------------------------------------------------------------------------
# The projects themselves ARE committed, deliberately.
#
# `npx cap add` can regenerate them, but only in their pristine form. A store
# release edits them by hand — permission purpose strings in Info.plist, the
# permissions and deep-link intent filters in AndroidManifest.xml, app icons,
# splash assets, the signing config — and every one of those is lost if the
# directory is treated as build output and regenerated. Capacitor's own guidance
# is to commit them for exactly this reason.
#
# What is ignored is what a BUILD produces inside them, which is large, machine-
# specific, and re-created by Gradle or Xcode on demand.
frontend/android/build/
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/.idea/
frontend/android/app/release/
frontend/android/captures/
frontend/ios/App/Pods/
frontend/ios/App/build/
frontend/ios/App/output/
frontend/ios/App/App/public/
frontend/android/app/src/main/assets/public/
frontend/ios/DerivedData/
frontend/ios/App/*.xcworkspace/xcuserdata/
frontend/ios/App/*.xcodeproj/xcuserdata/

# The copied web assets above are `dist-mobile` again under another name —
# written by `npx cap sync` on every build. Committing them would put two copies
# of the whole bundle in every diff and guarantee they drift apart.

# ------------------------------------------------------------------------------
# 14. Keys, Certificates & Service Credentials
# ------------------------------------------------------------------------------
# Section 4 keeps .env files out; these are the credential formats that arrive as
# their own files instead — a downloaded service account, a local TLS cert, an
# Android signing keystore. None belong in a repo, and a leak here is worse than
# a leak of source.
*.pem
*.key
*.crt
*.cer
*.der
*.pfx
*.p12
*.jks
*.keystore
secrets/
**/secrets/
*service-account*.json
gha-creds-*.json

# ------------------------------------------------------------------------------
# 15. Additional Editor, AI Assistant & Tooling Metadata
# ------------------------------------------------------------------------------
# Section 11 covers the editors this project has met so far; these are the rest,
# listed so a teammate on a different setup cannot commit their local config.
.history/
.cursor/
.cursorrules
.windsurf/
.windsurfrules
.zed/
.fleet/
.continue/
.aider*
.sourcegraph/
*.code-workspace

# ------------------------------------------------------------------------------
# 16. Process, Cache & Packaging Leftovers
# ------------------------------------------------------------------------------
*.pid
*.pid.lock
*.seed
.vitest/
**/.vitest/
.jest-cache/
**/.jest-cache/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz
*.tgz
*.tar.gz
*.zip
*.7z
*.rar

# Throwaway scripts written beside the code they probe. `**/*.tmp` above catches
# the .tmp suffix; this catches the .tmp- prefix convention, which is what a
# one-off db check or migration probe tends to be called.
.tmp-*
**/.tmp-*

# Extra OS leftovers not covered in section 10.
.AppleDouble
.LSOverride
Thumbs.db:encryptable

# ------------------------------------------------------------------------------
# 17. Python, Scratch Scripts & Temporary Files
# ------------------------------------------------------------------------------
*.py
*.pyc
*.pyo
*.pyd
__pycache__/
**/__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/
env/

# Scratch & temporary workspace directories
scratch/
**/scratch/
temp/
**/temp/
tmp/
**/tmp/
brain/
**/.system_generated/

# Scratch script patterns
scratch_*
scratch.*
*.scratch.*
*.scratch
temp_*
tmp_*
test_*.py
scratch_*.py
test_script*

# Scratch & temporary Markdown notes (preserves tracked durable documentation)
scratch*.md
**/scratch*.md
temp*.md
**/temp*.md
tmp*.md
**/tmp*.md
AUDIT*.md
audit_*.md
NOTES*.md
notes.md
*notes*.md
TODO*.md
todo*.md
walkthrough*.md
implementation_plan*.md
task*.md
plan*.md
scratch_*.md
test_*.md

# Database dumps & backup files
*.dump
*.sql.bak
*.sql.gz
*.sqlite
*.sqlite3
*.db

# Generated per-environment at build time by frontend/scripts/generate-robots.mjs.
# Never commit it: the committed copy would be wrong for 3 of the 4 Vercel projects.
frontend/public/robots.txt

# Generated per-environment at build time by frontend/scripts/generate-sitemap.mjs.
# Production builds write it; every other build deletes it, so a sitemap of
# production URLs can never be left behind in a development deployment.
frontend/public/sitemap.xml
# Written by scripts/generate-version.mjs at build time and read by the launch
# version gate. Committing it would pin every deployment to whatever SHA
# happened to be checked in, so the gate would compare against a stale value.
frontend/public/version.json

# ── Local security tooling output ────────────────────────────────────────────
# Scanner reports, caches and red-team configs are generated on one machine,
# name real paths and findings, and in the case of a secret scan quote the
# credential they found. None of it belongs in a shared repository.
#
# The tools themselves are installed OUTSIDE the repo (~/.local/bin,
# ~/.security-tools) and reports are written to ~/security-reports, so nothing
# here should ever match in normal use. These patterns exist for the case where
# a scanner is run with its default output path from inside the working tree —
# the one way this lands in a commit by accident.
#
# Deliberately narrow: named artefacts only, no directory wildcards that could
# swallow source. Note `*.sarif` is a scanner output format, not a source file.
.semgrep/
.semgrep_logs/
.trivycache/
.checkov.baseline
.zap/
.promptfoo/
promptfooconfig.yaml
*.sarif
gitleaks-report.json
trivy-report.json
osv-results.json
security-reports/

# ── Personal developer helper ────────────────────────────────────────────────
# `./build apk` builds the Android APK and installs it on a connected phone.
# Not committed: it encodes THIS machine's JDK and Android SDK locations, the
# same way frontend/android/local.properties (also ignored) does.
#
# Anchored with a leading slash so it matches the FILE at the repo root only.
# The `build/` and `**/build/` rules above are directory patterns and do not
# cover it.
/build
