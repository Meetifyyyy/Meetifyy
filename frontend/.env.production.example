# =============================================================================
# Frontend — PRODUCTION environment template
# =============================================================================
# These belong in the hosting platform's environment variables (Vercel project
# settings), NOT in a committed file — they must be present at BUILD time, since
# Vite inlines them into the bundle. Changing one requires a redeploy.
#
# Everything here is public (it ships in the bundle). No secrets.
# =============================================================================

VITE_APP_ENV=production
VITE_APP_NAME=Meetifyy
VITE_SITE_URL=https://meetifyy.com
VITE_INTERNAL_DOMAINS=meetifyy.com,www.meetifyy.com,app.meetifyy.com
VITE_SUPPORT_EMAIL=support@meetifyy.com

VITE_API_URL=https://api.meetifyy.com
VITE_API_PROXY_PREFIX=/_api
VITE_API_PREFER_LOCAL=false

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_STORAGE_PUBLIC_URL=https://cdn.meetifyy.com

VITE_UNSPLASH_KEY=
VITE_GIPHY_KEY=
VITE_SENTRY_DSN=
VITE_ANALYTICS_ID=

VITE_ENABLE_DEBUG_TOOLS=false
VITE_ENABLE_EXPERIMENTAL=false
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_VERSION_CHECK=true
