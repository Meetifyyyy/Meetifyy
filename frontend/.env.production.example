# =============================================================================
# Frontend — PRODUCTION environment template
# =============================================================================
# These belong in the hosting platform's environment variables (Vercel project
# settings), NOT in a committed file — they must be present at BUILD time, since
# Vite inlines them into the bundle. Changing one requires a redeploy.
#
# Everything here is public (it ships in the bundle). No secrets.
# =============================================================================

VITE_APP_ENV=production
VITE_APP_NAME=Meetifyy
VITE_SITE_URL=https://meetifyy.app
VITE_INTERNAL_DOMAINS=meetifyy.app,www.meetifyy.app,app.meetifyy.app
# Shown as the support contact. Must be an address that actually receives
# mail — neither meetifyy.com nor meetifyy.app publishes an MX record today.
VITE_SUPPORT_EMAIL=

VITE_API_URL=https://api.meetifyy.app
VITE_API_PROXY_PREFIX=/_api
VITE_API_PREFER_LOCAL=false
# Only consulted when VITE_API_PREFER_LOCAL is true (local development).
VITE_API_LOCAL_PORT=4000

# The ANON key only — it ships in the bundle. The service-role key must never
# appear in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_STORAGE_PUBLIC_URL=https://cdn.meetifyy.app

VITE_UNSPLASH_KEY=
VITE_GIPHY_KEY=
VITE_SENTRY_DSN=
VITE_ANALYTICS_ID=

VITE_ENABLE_DEBUG_TOOLS=false
VITE_ENABLE_EXPERIMENTAL=false
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_VERSION_CHECK=true
