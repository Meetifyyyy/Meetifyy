# =============================================================================
# Frontend — DEVELOPMENT environment template
# =============================================================================
# Copy to `.env.development` (git-ignored). Vite loads it automatically when the
# mode is "development" (`npm run dev`).
# All values are build-time and public — see .env.example for the full list.
# =============================================================================

VITE_APP_ENV=development
VITE_SITE_URL=http://localhost:3000
VITE_INTERNAL_DOMAINS=localhost,127.0.0.1

VITE_API_URL=http://127.0.0.1:4000
VITE_API_LOCAL_PORT=4000
VITE_API_PREFER_LOCAL=true

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_STORAGE_PUBLIC_URL=

VITE_ENABLE_DEBUG_TOOLS=true
VITE_ENABLE_SERVICE_WORKER=false
VITE_ENABLE_VERSION_CHECK=false

VITE_DEV_SERVER_PORT=3000
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:4000
