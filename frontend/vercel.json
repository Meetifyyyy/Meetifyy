      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/|fonts/|icons/|favicon\\.png|.*\\.[a-zA-Z0-9]+$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' blob: https://meetifyy.app; script-src-elem 'self' 'unsafe-inline' blob: https://meetifyy.app https://cdn.jsdelivr.net https://static.cloudflareinsights.com; worker-src 'self' blob: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://meetifyy.app; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com https://meetifyy.app; font-src 'self' https://fonts.gstatic.com; manifest-src 'self' https://meetifyy.app; img-src 'self' data: blob: http: https: https://*.supabase.co https://*.r2.dev https://cdn.meetifyy.app; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.r2.dev https://cdn.meetifyy.app http: https: ws: wss:; media-src 'self' data: blob: http: https: https://*.supabase.co https://*.r2.dev https://cdn.meetifyy.app; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' blob: https://meetifyy.app 'sha256-nJoQ8qj7AksgjMkfUbJ85T5Vt59asfVnYMbiZlDAE2I=' 'sha256-nv2E9tVsL9FGPyDKqFZZDvCETuNL6NFByLpNQRkij1g=' 'sha256-VjZU9JHgyMaOReRZPwesj6MvdzjfXf1qLv9dotfrwzI='; script-src-elem 'self' blob: https://meetifyy.app https://cdn.jsdelivr.net https://static.cloudflareinsights.com 'sha256-nJoQ8qj7AksgjMkfUbJ85T5Vt59asfVnYMbiZlDAE2I=' 'sha256-nv2E9tVsL9FGPyDKqFZZDvCETuNL6NFByLpNQRkij1g=' 'sha256-VjZU9JHgyMaOReRZPwesj6MvdzjfXf1qLv9dotfrwzI='; worker-src 'self' blob: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://meetifyy.app; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com https://meetifyy.app; font-src 'self' https://fonts.gstatic.com; manifest-src 'self' https://meetifyy.app; img-src 'self' data: blob: http: https: https://*.supabase.co https://*.r2.dev https://cdn.meetifyy.app; connect-src 'self' https://api.meetifyy.app wss://api.meetifyy.app https://*.supabase.co wss://*.supabase.co https://*.r2.dev https://cdn.meetifyy.app; media-src 'self' data: blob: http: https: https://*.supabase.co https://*.r2.dev https://cdn.meetifyy.app; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
