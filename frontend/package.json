{
  "name": "meetifyy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-robots.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-version.mjs && vite build && node scripts/prerender-seo.mjs",
    "build:dev": "node scripts/generate-robots.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-version.mjs && vite build --mode development && node scripts/prerender-seo.mjs",
    "build:mobile": "vite build --config vite.mobile.config.js",
    "build:mobile:dev": "vite build --config vite.mobile.config.js --mode development",
    "dev": "vite",
    "dev:mobile": "vite --config vite.mobile.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "mobile:sync": "npm run build:mobile && npx cap sync",
    "og:asset": "node scripts/generate-og-image.mjs",
    "perf": "vitest run --config src/__perf__/vitest.perf.config.js --silent=false",
    "preview": "vite preview",
    "preview:mobile": "vite preview --config vite.mobile.config.js --port 4174",
    "pwa:assets": "node scripts/generate-pwa-assets.mjs",
    "robots": "node scripts/generate-robots.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "version:stamp": "node scripts/generate-version.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@supabase/auth-js": "^2.110.7",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "browser-image-compression": "^2.0.2",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^12.40.0",
    "fuse.js": "^7.4.2",
    "html2canvas": "^1.4.1",
    "immer": "^11.1.15",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.3",
    "react-hook-form": "^7.82.0",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^28.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "ejs": "^6.0.1",
    "fast-uri": "^3.1.5",
    "postcss": "^8.5.26",
    "react-router": "7.18.2",
    "@eslint/config-array": {
      "brace-expansion": "^1.1.12"
    },
    "@eslint/eslintrc": {
      "brace-expansion": "^1.1.12"
    },
    "eslint": {
      "brace-expansion": "^1.1.12"
    }
  }
}
