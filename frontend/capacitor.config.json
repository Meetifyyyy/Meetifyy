{
  "appId": "app.meetifyy",
  "appName": "Meetifyy",
  "webDir": "dist-mobile",
  "loggingBehavior": "none",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}
