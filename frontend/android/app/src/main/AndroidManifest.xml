<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".MeetifyyApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Android App Links for the shareable routes. appLinkHost is set
                per build type in app/build.gradle (debug opens the development
                site, release the production one), and Android only hands a
                link to this app once that host's /.well-known/assetlinks.json
                lists this build's signing certificate. Until then the link
                opens in the browser, which is the correct fallback.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${appLinkHost}" />
                <data android:pathPrefix="/post/" />
                <data android:pathPrefix="/profile/" />
                <data android:pathPrefix="/communities/" />
                <data android:pathPrefix="/crew/" />
            </intent-filter>

        </activity>

        <!--
            Push notifications (FCM, see docs/push-notifications.md). Used for
            a notification that names no channel or a channel this build does
            not have; the server always names one of the four this app creates.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="social" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notificationAccent" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
        Package visibility (Android 11+): without this, resolveActivity cannot
        see Instagram and every share would report it as not installed.
    -->
    <queries>
        <package android:name="com.instagram.android" />
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Android 13+ asks before an app may post notifications. Requested from
        Settings or the opt-in card, never at launch. Declared here as well as
        by the push plugin so the requirement is visible in this file.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        The live-selfie check runs getUserMedia inside the WebView. Capacitor's
        BridgeWebChromeClient answers the page's camera request by asking for
        this runtime permission, and Android refuses a runtime request for a
        permission the manifest does not declare: without this line the camera
        was denied instantly and the selfie step could never start in the app.
        The camera is not required to install the app (no camera, no selfie,
        everything else still works), so Play does not filter devices on it.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
        Voice messages in chat use getUserMedia for audio. As with the camera,
        BridgeWebChromeClient can only ask for RECORD_AUDIO if the manifest
        declares it; without it the microphone was denied instantly and every
        recording attempt showed "Microphone access denied". MODIFY_AUDIO_SETTINGS
        lets the WebView route capture through the voice audio mode.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
</manifest>
