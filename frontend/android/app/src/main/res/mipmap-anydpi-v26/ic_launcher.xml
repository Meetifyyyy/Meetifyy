<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <!--
      NO monochrome layer, deliberately.

      One was added here so Android 13+ could tint the icon to the system
      palette. On the device this ships to it rendered as a featureless grey
      square: the launcher's themed mode discarded the mark entirely and drew a
      filled plate. A themed icon needs a drawable authored as a flat
      silhouette, not a full-colour foreground handed over as one.

      A blank square is worse than an untinted icon, so until there is a real
      silhouette asset this layer stays out and launchers fall back to the
      full-colour adaptive icon below.
    -->
</adaptive-icon>