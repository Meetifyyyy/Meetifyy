<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12+ (android:dataExtractionRules).
    Mirrors backup_rules.xml, which older versions read: the session credential
    file is never copied off the device, to the cloud or to a new phone. See
    that file for why.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
