<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 11 and below (android:fullBackupContent).

    Backup is off (android:allowBackup="false"), and on these versions that
    alone stops both cloud backup and device transfer. Everything is excluded
    here as well, so the rules stay correct if the flag is ever turned back on.
    Every account's data lives on the server; see data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
