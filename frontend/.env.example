# Supabase config (Safe for client/browser exposure)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Frontend app base URL for email redirects
VITE_SITE_URL=https://dev.meetifyy.app

# NestJS API backend base URL
VITE_API_URL=http://127.0.0.1:4000

# Third-party integrations
VITE_UNSPLASH_KEY=your-unsplash-access-key-here
VITE_GIPHY_KEY=your-giphy-api-key-here
