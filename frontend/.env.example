# =============================================================================
# Meetifyy Frontend — environment template
# =============================================================================
# Copy to .env.local (git-ignored) for developer-specific values.
#
# ⚠️  BUILD-TIME AND PUBLIC.
# Vite inlines every VITE_* variable into the bundle at build time, and the
# bundle is served to browsers. That means:
#   • changing one of these has NO effect until the app is rebuilt;
#   • anything here is readable by anyone using the app.
# Never put a service-role key, database URL, JWT secret or email API key in
# this file. Those belong to the backend environment only.
#
# See docs/environment-configuration.md.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
# development | staging | production. Defaults to the Vite mode.
VITE_APP_ENV=development
VITE_APP_NAME=Meetifyy
# The app's own public base URL, used for absolute links (auth email redirects).
# Falls back to the current browser origin when empty.
VITE_SITE_URL=http://localhost:3000
# Extra hostnames treated as "this app" when classifying a pasted link. The
# current origin always counts. Comma-separated.
VITE_INTERNAL_DOMAINS=localhost,127.0.0.1
VITE_SUPPORT_EMAIL=

# ── API ──────────────────────────────────────────────────────────────────────
# Absolute backend origin. Required for production builds.
# Leave empty to use the same origin (the dev-server proxy, or a deployment that
# serves the API under its own domain).
VITE_API_URL=http://127.0.0.1:4000
# Same-origin path that proxies to the backend, used as a failover when the
# direct API origin is blocked by a filtered network.
VITE_API_PROXY_PREFIX=/_api
# Port the backend listens on when it runs alongside this app locally.
VITE_API_LOCAL_PORT=4000
# When true, a page served from localhost/LAN talks to a backend on that same
# host instead of VITE_API_URL. Defaults to true for dev builds only.
VITE_API_PREFER_LOCAL=

# ── Auth redirect paths ──────────────────────────────────────────────────────
VITE_AUTH_CALLBACK_PATH=/auth/callback
VITE_AUTH_RESET_PASSWORD_PATH=/reset-password
VITE_AUTH_VERIFY_EMAIL_PATH=/verify-email

# ── Supabase (client-safe keys only) ─────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Storage ──────────────────────────────────────────────────────────────────
# Public origin media is served from (CDN or bucket public host).
VITE_STORAGE_PUBLIC_URL=

# ── Third-party integrations (public keys) ───────────────────────────────────
VITE_UNSPLASH_KEY=
VITE_GIPHY_KEY=
VITE_SENTRY_DSN=
VITE_ANALYTICS_ID=

# ── Features ─────────────────────────────────────────────────────────────────
VITE_ENABLE_DEBUG_TOOLS=true
VITE_ENABLE_EXPERIMENTAL=false
# Both default to on for production builds and off for dev builds.
VITE_ENABLE_VERSION_CHECK=
VITE_ENABLE_SERVICE_WORKER=

# ── Local dev server (used by vite.config.js, not by app code) ───────────────
VITE_DEV_SERVER_PORT=3000
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:4000
