# =============================================================================
# Meetifyy Admin Frontend — environment template
# =============================================================================
# Copy to .env.local (git-ignored) for developer-specific values.
#
# ⚠️  BUILD-TIME AND PUBLIC — every VITE_* value is inlined into the bundle and
# served to browsers. Never place secrets here.
# =============================================================================

# development | staging | production. Defaults to the Vite mode.
VITE_APP_ENV=development
VITE_APP_NAME=Meetifyy Admin

# Absolute backend origin. Required for production builds.
# Leave empty to use the same origin.
VITE_API_URL=http://127.0.0.1:4000
# Port the backend listens on when it runs alongside this app locally.
VITE_API_LOCAL_PORT=4000
# When true, a page served from localhost/LAN talks to a backend on that same
# host instead of VITE_API_URL. Defaults to true for dev builds only.
VITE_API_PREFER_LOCAL=
# Prefix of the session cookie names, matching the backend's COOKIE_NAME_PREFIX:
# the admin CSRF cookie is `admin_csrf` in production and `<prefix>_admin_csrf`
# elsewhere. Derived from VITE_APP_ENV when unset (`mf` for production, `mf_dev`
# for development). Leave unset unless the backend's prefix is overridden.
VITE_SESSION_COOKIE_PREFIX=

# Local dev server (used by vite.config.ts, not by app code).
VITE_DEV_SERVER_PORT=5174
# Public website origin, for "View on website" links in the Legal section.
VITE_PUBLIC_SITE_URL=https://meetifyy.app
