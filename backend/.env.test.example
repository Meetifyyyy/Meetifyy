# =============================================================================
# Backend — TEST environment template
# =============================================================================
# Copy to `.env.test` (git-ignored). Used by the automated test suite.
# The test database is wiped freely, so it must never be a shared one.
# =============================================================================

NODE_ENV=test
APP_ENV=test

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Dedicated throwaway test database.
DATABASE_URL=
DIRECT_URL=

SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key

# Mail is captured, never delivered.
EMAIL_DRIVER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM=test@meetifyy.local
DEV_EMAIL_REDIRECT=test@meetifyy.local

LOG_LEVEL=warn
LOG_PRETTY=false
LOG_QUERIES=false
