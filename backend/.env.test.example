# =============================================================================
# Backend — TEST environment template
# =============================================================================
# Copy to `.env.test` (git-ignored). Used by the automated test suite.
# The test database is wiped freely, so it must never be a shared one.
# =============================================================================

NODE_ENV=test
APP_ENV=test

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Dedicated throwaway test database.
DATABASE_URL=
DIRECT_URL=

SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key

# Mail is captured, never delivered.
EMAIL_DRIVER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM=test@meetifyy.local
DEV_EMAIL_REDIRECT=test@meetifyy.local

LOG_LEVEL=warn
LOG_PRETTY=false
LOG_QUERIES=false

# ── Mobile release gate ──────────────────────────────────────────────────────
# Served publicly by GET /api/app/version and read by the installed apps at
# cold start and on resume.
#
# The installed app carries its own copy of the web bundle, so a frontend
# deploy never reaches it. These are the only lever the API has over a build
# that is already on someone's phone.
#
# MIN blocks: below it the app refuses to run. LATEST nudges: below it the user
# sees a dismissible banner. Keep them apart — a single value turns every
# routine release into a forced upgrade.
#
# Both default to 0.0.0, which gates nobody. Leave them unset until there is a
# build you genuinely need to retire, and raise MIN only for a broken or unsafe
# release, never for a feature.
MOBILE_MIN_VERSION_ANDROID=0.0.0
MOBILE_LATEST_VERSION_ANDROID=0.0.0
MOBILE_STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=app.meetifyy
MOBILE_MIN_VERSION_IOS=0.0.0
MOBILE_LATEST_VERSION_IOS=0.0.0
MOBILE_STORE_URL_IOS=
