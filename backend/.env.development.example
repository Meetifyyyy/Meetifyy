# =============================================================================
# Backend — DEVELOPMENT environment template
# =============================================================================
# Copy to `.env.development` (git-ignored) and add credentials.
# Only the values that DIFFER between environments are listed; everything else
# is documented in .env.example and has a sensible default.
#
# Precedence reminder: .env.development.local → .env.local → .env.development → .env
# =============================================================================

NODE_ENV=development
APP_ENV=development

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000/api
ADMIN_URL=http://localhost:5174

CORS_ALLOW_LOCAL_NETWORK=true
# How long a browser may reuse one CORS preflight result (seconds, max 86400).
# Every API call carries an Authorization header and is therefore preceded by an
# OPTIONS preflight; without this the round trip is paid twice on every request.
# Lower it if the allowed methods/headers ever need to change quickly.
CORS_MAX_AGE_SECONDS=86400
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Point at the DEVELOPMENT database. Never a production connection string.
DATABASE_URL=
DIRECT_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STORAGE_PROVIDER=r2
R2_BUCKET_NAME=meetifyy-dev
R2_PUBLIC_URL=

# Local Mailpit — `npm run mailpit`, inbox at http://127.0.0.1:8025
EMAIL_DRIVER=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM=noreply@meetifyy.local

FEATURE_DEV_ENDPOINTS=true
FEATURE_DEBUG_TOOLS=true
FEATURE_RELAXED_RATE_LIMITS=true
LOG_LEVEL=debug
LOG_PRETTY=true
LOG_QUERIES=true
