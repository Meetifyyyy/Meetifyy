# =============================================================================
# Backend — DEVELOPMENT environment template
# =============================================================================
# Copy to `.env.development` (git-ignored) and add credentials.
# Only the values that DIFFER between environments are listed; everything else
# is documented in .env.example and has a sensible default.
#
# Precedence reminder: .env.development.local → .env.local → .env.development → .env
# =============================================================================

NODE_ENV=development
APP_ENV=development

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000/api
ADMIN_URL=http://localhost:5174

CORS_ALLOW_LOCAL_NETWORK=true
# How long a browser may reuse one CORS preflight result (seconds, max 86400).
# Every API call carries an Authorization header and is therefore preceded by an
# OPTIONS preflight; without this the round trip is paid twice on every request.
# Lower it if the allowed methods/headers ever need to change quickly.
CORS_MAX_AGE_SECONDS=86400
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Point at the DEVELOPMENT database. Never a production connection string.
DATABASE_URL=
DIRECT_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STORAGE_PROVIDER=r2
R2_BUCKET_NAME=meetifyy-dev
R2_PUBLIC_URL=

# Local Mailpit — `npm run mailpit`, inbox at http://127.0.0.1:8025
EMAIL_DRIVER=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM=noreply@meetifyy.local

FEATURE_DEV_ENDPOINTS=true
FEATURE_DEBUG_TOOLS=true
# ── Rate limiting ────────────────────────────────────────────────────────────
# Limit VALUES are not configurable by environment — they live in
# src/config/rate-limit.config.ts and are identical in every environment, so a
# limit cannot be quietly weakened where nobody is looking. Only infrastructure
# is set here.

# How many reverse proxies sit between the internet and this process.
# MUST match the real deployment. Too low and every client resolves to the
# proxy address, collapsing all IP-keyed limits into one shared bucket; too high
# and the caller's own X-Forwarded-For entry is trusted, which is spoofable.
# 0 = Express talks to the client directly (local). Verify by checking that a
# request carrying a forged X-Forwarded-For does not change the resolved IP.
TRUST_PROXY_HOPS=0

# Redis key namespace, so environments sharing one Redis cannot consume each
# other's budgets. Defaults to rl:<APP_ENV>.
RATE_LIMIT_KEY_PREFIX=

# Secret used to hash IPs and email addresses before they become Redis keys or
# log fields. Falls back to SUPABASE_JWT_SECRET when unset.
RATE_LIMIT_HASH_SECRET=

# 'enforce' (default, and the only value accepted in production) or 'shadow',
# which evaluates every policy and records the decision without rejecting
# anything. Shadow exists for measuring real traffic before turning a new limit
# on; it is refused in production so it cannot become an accidental bypass.
RATE_LIMIT_MODE=enforce
LOG_LEVEL=debug
LOG_PRETTY=true
LOG_QUERIES=true
