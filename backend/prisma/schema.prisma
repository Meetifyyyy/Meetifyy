/// Lifecycle of the *conversation* a match opened, tracked separately from
/// MatchStatus — which describes the accept handshake and is finished by the
/// time a chat exists. Keeping them apart means the 24h chat's states cannot
/// disturb the matching state machine (or the re-match cooldown that reads it).
enum InstantMatchChatStatus {
  /// Inside the 24h window and both users are still in.
  ACTIVE
  /// One participant chose "Find someone new".
  ENDED_BY_USER
  /// The 24h window elapsed.
  EXPIRED
}

