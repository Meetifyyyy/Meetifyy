generator client {
  provider        = "prisma-client-js"
  // PERF: lets Prisma load nested relations with a LATERAL JOIN in a single
  // statement instead of issuing one query per relation. Without it a profile
  // feed page fanned out into 6 sequential round-trips (post, author, college,
  // media, pollOptions, pollVotes) at ~60ms each — the relation count, not the
  // row count, set the latency.
  // `driverAdapters` lets Prisma talk to Postgres through node-postgres instead
  // of its own Rust connection layer. That matters on Supabase's transaction
  // pooler: the Rust path wraps every query in BEGIN / DEALLOCATE ALL / COMMIT
  // when `pgbouncer=true`, turning one 31ms query into ~155ms, while dropping
  // that flag makes it fail outright with "prepared statement does not exist".
  // node-postgres uses unnamed prepared statements, which are safe under
  // transaction pooling — so this is what allows transaction mode (many clients
  // multiplexed over few server connections) without the amplification.
  previewFeatures = ["relationJoins", "driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model College {
  id            String          @id @default(uuid())
  name          String
  shortName     String?
  slug          String?         @unique
  logoKey       String?
  logoMediaId   String?
  bannerKey     String?
  bannerMediaId String?
  city          String?
  state         String?
  country       String?
  isActive      Boolean         @default(true)
  isVerified    Boolean         @default(false)
  isPrivate     Boolean         @default(false)
  status        CollegeStatus   @default(APPROVED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  bannerMedia   Media?          @relation("CollegeBanner", fields: [bannerMediaId], references: [id])
  logoMedia     Media?          @relation("CollegeLogo", fields: [logoMediaId], references: [id])
  domains       CollegeDomain[]
  communities   Community[]     @relation("CommunityCollege")
  activities    CrewActivity[]  @relation("ActivityCollege")
  campusEvents  CampusEvent[]
  users         User[]

  @@index([status])
  @@index([isActive])
  @@index([deletedAt])
}

model CollegeDomain {
  id         String       @id @default(uuid())
  domain     String       @unique
  collegeId  String
  isPrimary  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  isVerified Boolean      @default(true)
  status     DomainStatus @default(ACTIVE)
  updatedAt  DateTime     @updatedAt
  college    College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([collegeId, isPrimary])
  @@index([status])
  @@index([domain, status])
}

model UserSettings {
  id                String  @id @default(uuid())
  userId            String  @unique
  emailNotifs       Boolean @default(true)
  pushNotifs        Boolean @default(false)
  privateProfile    Boolean @default(false)
  showOnlineStatus  Boolean @default(true)
  showLastSeen      Boolean @default(true)
  whoCanSeeOnline   String  @default("everyone")
  whoCanSeeLastSeen String  @default("everyone")
  readReceipts      Boolean @default(true)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreferences {
  id         String   @id @default(uuid())
  userId     String   @unique
  likes      Boolean  @default(true)
  comments   Boolean  @default(true)
  mentions   Boolean  @default(true)
  messages   Boolean  @default(true)
  activities Boolean  @default(true)
  groups     Boolean  @default(true)
  system     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Media {
  id                  String         @id @default(uuid())
  provider            String         @default("supabase")
  bucket              String         @default("meetifyy-dev")
  objectKey           String         @unique
  storageKey          String?
  type                String?
  mimeType            String         @default("application/octet-stream")
  fileSize            Int            @default(0)
  checksum            String?
  width               Int?
  height              Int?
  duration            Int?
  visibility          String         @default("public")
  order               Int            @default(0)
  ownerId             String
  postId              String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  bannerColleges      College[]      @relation("CollegeBanner")
  logoColleges        College[]      @relation("CollegeLogo")
  avatarCommunities   Community[]    @relation("CommunityAvatar")
  coverCommunities    Community[]    @relation("CommunityCover")
  avatarConversations Conversation[] @relation("ConversationAvatar")
  coverActivities     CrewActivity[] @relation("ActivityCover")
  campusEventPosters  CampusEvent[]  @relation("CampusEventPoster")
  owner               User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  post                Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  messageAttachments  Message[]      @relation("MessageAttachment")
  avatarUsers         User[]         @relation("UserAvatar")
  coverUsers          User[]         @relation("UserCover")

  @@index([postId])
}

model User {
  id                         String                      @id @default(uuid())
  username                   String                      @unique
  displayName                String
  email                      String                      @unique
  bio                        String?
  course                     String?
  branch                     String?
  currentYear                Int?
  location                   String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  avatar                     String?
  avatarMediaId              String?
  collegeEmail               String?
  collegeId                  String?
  cover                      String?
  coverMediaId               String?
  deletedAt                  DateTime?
  emailVerified              Boolean                     @default(false)
  birthday                   String?
  interests                  String[]
  lastSeenAt                 DateTime?
  phoneVerified              Boolean                     @default(false)
  profileCompleted           Boolean                     @default(false)
  accountStatus              AccountStatus               @default(ACTIVE)
  role                       UserRole                    @default(USER)
  canPost                    Boolean                     @default(true)
  canMessage                 Boolean                     @default(true)
  canActivity                Boolean                     @default(true)
  // Campus Representative flag. Assignable ONLY by a Super Admin (admin portal);
  // never accepted by any /api/* user-facing endpoint or profile update.
  isCampusRep                Boolean                     @default(false)
  activityBookmarks          ActivityBookmark[]
  campusEventsCreated        CampusEvent[]               @relation("CampusEventCreator")
  invitationsReceived        ActivityInvitation[]        @relation("ActivityInvitationsReceived")
  invitationsSent            ActivityInvitation[]        @relation("ActivityInvitationsSent")
  blocksReceived             Block[]                     @relation("Blocked")
  blocksMade                 Block[]                     @relation("Blocker")
  comments                   Comment[]
  commentLikes               CommentLike[]
  ownedCommunities           Community[]                 @relation("CommunityOwner")
  communityJoinRequests      CommunityJoinRequest[]
  communityMembers           CommunityMember[]
  ownedConversations         Conversation[]              @relation("ConversationOwner")
  groupJoinRequests          ConversationJoinRequest[]
  conversationParticipants   ConversationParticipant[]
  crewActivitiesCreated      CrewActivity[]              @relation("ActivityCreator")
  crewActivities             CrewActivityMember[]
  activityDiscussionMessages ActivityDiscussionMessage[]
  deletedMessages            DeletedMessage[]
  following                  Follow[]                    @relation("follower")
  followers                  Follow[]                    @relation("following")
  matchQueueEntry            MatchQueueEntry?
  matchesAsA                 MatchSession[]              @relation("MatchUserA")
  matchesAsB                 MatchSession[]              @relation("MatchUserB")
  media                      Media[]
  mentions                   Mention[]                   @relation("MentionedUser")
  sentMessages               Message[]
  messageReactions           MessageReaction[]
  mutesMade                  Mute[]                      @relation("Muter")
  actorNotifications         Notification[]              @relation("NotificationActor")
  notifications              Notification[]              @relation("NotificationRecipient")
  notificationPrefs          NotificationPreferences?
  pollVotes                  PollVote[]
  posts                      Post[]
  bookmarks                  PostBookmark[]
  likes                      PostLike[]
  shares                     PostShare[]
  recentSearches             RecentSearch[]
  reportsMade                Report[]                    @relation("Reporter")
  supportTickets             SupportTicket[]
  avatarMedia                Media?                      @relation("UserAvatar", fields: [avatarMediaId], references: [id])
  college                    College?                    @relation(fields: [collegeId], references: [id])
  coverMedia                 Media?                      @relation("UserCover", fields: [coverMediaId], references: [id])
  settings                   UserSettings?

  @@index([collegeId])
  @@index([collegeId, createdAt(sort: Desc)])
  // Campus directory filter patterns: WHERE collegeId=? AND course=? / branch=? / currentYear=?.
  @@index([collegeId, course])
  @@index([collegeId, course, branch])
  @@index([collegeId, currentYear])
  @@index([deletedAt, createdAt])
  @@index([lastSeenAt])
  @@index([createdAt])
  // Campus Representatives listing (Super Admin portal), scoped per campus.
  @@index([collegeId, isCampusRep])
  // Empty-query invite/connections list: WHERE accountStatus='ACTIVE' ORDER BY createdAt DESC.
  @@index([accountStatus, createdAt(sort: Desc)])
  // Speeds up the signup email-availability check (OR email/collegeEmail).
  @@index([collegeEmail])
}

model Post {
  id           String         @id @default(uuid())
  authorId     String
  communityId  String?
  text         String         @db.VarChar(2000)
  mentions     Json?
  likeCount    Int            @default(0)
  commentCount Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  comments     Comment[]
  media        Media[]
  pollOptions  PollOption[]
  pollVotes    PollVote[]
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community    Community?     @relation(fields: [communityId], references: [id])
  bookmarks    PostBookmark[]
  hashtags     PostHashtag[]
  likes        PostLike[]
  shares       PostShare[]

  @@index([authorId])
  @@index([createdAt])
  @@index([deletedAt, createdAt])
  @@index([authorId, deletedAt, createdAt(sort: Desc)])
  @@index([deletedAt, createdAt(sort: Desc), authorId])
  // Covers (deletedAt, createdAt DESC, id DESC) — the exact keyset-pagination order
  // used by the feed, profile, and search queries, eliminating the in-memory id sort.
  @@index([deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index([communityId, deletedAt, createdAt(sort: Desc)])
}

model PostLike {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Comment {
  id             String        @id @default(uuid())
  postId         String
  authorId       String
  text           String        @db.VarChar(500)
  mentions       Json?
  parentId       String?
  likeCount      Int           @default(0)
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?
  isDeleted      Boolean       @default(false)
  deletedByUser  Boolean       @default(false)
  removalReason  String?       @db.VarChar(200)
  removedByOwner Boolean       @default(false)
  author         User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent         Comment?      @relation("replies", fields: [parentId], references: [id])
  replies        Comment[]     @relation("replies")
  post           Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes          CommentLike[]

  @@index([postId])
  @@index([postId, createdAt])
  @@index([authorId])
  @@index([isDeleted, postId])
  @@index([deletedAt, createdAt])
}

model CommentLike {
  userId    String
  commentId String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([userId])
  @@index([commentId])
}

model Community {
  id                String                 @id @default(uuid())
  name              String
  slug              String                 @unique
  description       String?
  avatarKey         String?
  avatarMediaId     String?
  coverKey          String?
  coverMediaId      String?
  color             String?
  isPrivate         Boolean                @default(false)
  memberCount       Int                    @default(0)
  createdAt         DateTime               @default(now())
  deletedAt         DateTime?
  ownerId           String?
  updatedAt         DateTime               @updatedAt
  collegeId         String?
  isCampusCommunity Boolean                @default(false)
  avatarMedia       Media?                 @relation("CommunityAvatar", fields: [avatarMediaId], references: [id])
  college           College?               @relation("CommunityCollege", fields: [collegeId], references: [id])
  coverMedia        Media?                 @relation("CommunityCover", fields: [coverMediaId], references: [id])
  owner             User?                  @relation("CommunityOwner", fields: [ownerId], references: [id])
  joinRequests      CommunityJoinRequest[]
  members           CommunityMember[]
  posts             Post[]

  @@index([ownerId])
  @@index([deletedAt, memberCount(sort: Desc)])
  @@index([deletedAt, isCampusCommunity, memberCount(sort: Desc)])
  @@index([collegeId, isCampusCommunity, deletedAt, memberCount(sort: Desc)])
}

model CommunityMember {
  userId      String
  communityId String
  joinedAt    DateTime      @default(now())
  role        CommunityRole @default(MEMBER)
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, communityId])
  @@index([userId])
  @@index([communityId])
  @@index([communityId, role])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([followingId, createdAt(sort: Desc)])
  @@index([followerId, createdAt(sort: Desc)])
}

model Conversation {
  id                  String                    @id @default(uuid())
  publicId            String?                   @unique
  name                String?
  avatarKey           String?
  avatarMediaId       String?
  isPrivate           Boolean                   @default(false)
  ownerId             String?
  createdAt           DateTime                  @default(now())
  allowSharing        Boolean                   @default(true)
  editGroupPermission String                    @default("ADMIN")
  visibility          String                    @default("PUBLIC")
  whoCanJoin          String                    @default("ANYONE")
  description         String?
  inviteCode          String?
  inviteLink          String?
  memberCount         Int                       @default(0)
  pinnedMessageId     String?
  isInstantMatch      Boolean                   @default(false)
  expiresAt           DateTime?
  status              String                    @default("ACTIVE")
  lastMessageId       String?
  lastMessageText     String?
  lastMessageType     String?
  lastMessageAt       DateTime?
  lastMessageSenderId String?
  updatedAt           DateTime                  @updatedAt
  type                ConversationType
  avatarMedia         Media?                    @relation("ConversationAvatar", fields: [avatarMediaId], references: [id])
  owner               User?                     @relation("ConversationOwner", fields: [ownerId], references: [id])
  pinnedMessage       Message?                  @relation("PinnedMessage", fields: [pinnedMessageId], references: [id])
  joinRequests        ConversationJoinRequest[]
  participants        ConversationParticipant[]
  messages            Message[]                 @relation("ConversationMessages")

  @@index([ownerId])
  @@index([updatedAt(sort: Desc)])
}

model ConversationParticipant {
  userId             String
  conversationId     String
  joinedAt           DateTime         @default(now())
  role               ConversationRole @default(MEMBER)
  lastReadAt         DateTime?
  isMuted            Boolean          @default(false)
  isPinned           Boolean          @default(false)
  groupUpdatesActive Boolean          @default(true)
  unreadCount        Int              @default(0)
  clearedAt          DateTime?
  leftAt             DateTime?
  deletedAt          DateTime?
  conversation       Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
  @@index([userId, deletedAt])
  @@index([userId, deletedAt, leftAt])
  @@index([conversationId, deletedAt])
  @@index([conversationId, deletedAt, userId])
  @@index([conversationId, deletedAt, leftAt, userId])
}

model Message {
  id                String            @id @default(uuid())
  clientMessageId   String?
  conversationId    String
  senderId          String
  createdAt         DateTime          @default(now())
  deletedAt         DateTime?
  editedAt          DateTime?
  payload           Json?
  replyToId         String?
  pinnedIn          Conversation[]    @relation("PinnedMessage")
  deletedByUsers    DeletedMessage[]
  type              MessageType       @default(CHAT)
  state             MessageState      @default(NORMAL)
  attachmentMediaId String?
  attachmentMedia   Media?            @relation("MessageAttachment", fields: [attachmentMediaId], references: [id])
  conversation      Conversation      @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo           Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies           Message[]         @relation("MessageReplies")
  sender            User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions         MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([conversationId, createdAt, senderId])
  @@index([conversationId, deletedAt, createdAt(sort: Desc)])
  @@index([conversationId, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index([senderId])
  @@index([senderId, clientMessageId])
}

model CrewActivity {
  id                 String                      @id @default(uuid())
  creatorId          String
  title              String
  description        String?
  location           String?
  maxMembers         Int?
  createdAt          DateTime                    @default(now())
  coverImage         String?
  coverMediaId       String?
  coverColor         String?
  deletedAt          DateTime?
  endDate            DateTime?
  latitude           Float?
  longitude          Float?
  startDate          DateTime?
  status             CrewActivityStatus          @default(OPEN)
  updatedAt          DateTime                    @updatedAt
  hostCollege        String?
  collegeId          String?
  participationType  CrewParticipationType       @default(OPEN)
  shareToCampus      Boolean                     @default(false)
  visibility         ActivityVisibility          @default(PUBLIC)
  bookmarks          ActivityBookmark[]
  invitations        ActivityInvitation[]
  discussionMessages ActivityDiscussionMessage[]
  college            College?                    @relation("ActivityCollege", fields: [collegeId], references: [id])
  coverMedia         Media?                      @relation("ActivityCover", fields: [coverMediaId], references: [id])
  creator            User                        @relation("ActivityCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members            CrewActivityMember[]

  @@index([creatorId])
  @@index([createdAt])
  @@index([status])
  @@index([deletedAt, status, createdAt])
  @@index([status, createdAt(sort: Desc)])
  @@index([collegeId, status, createdAt(sort: Desc)])
  @@index([visibility, status, createdAt(sort: Desc)])
  @@index([deletedAt, status, visibility, createdAt(sort: Desc)])
  @@index([status, deletedAt, endDate, startDate])
  // Upcoming-activity scans ordered by start time: the "For You" ranking pool
  // and every "hasn't started yet" filter. The existing
  // [status, deletedAt, endDate, startDate] index cannot serve the ORDER BY
  // because endDate sits between the equality columns and startDate.
  @@index([status, deletedAt, startDate])
  // Same shape, scoped to one college (College tab and its preview).
  @@index([collegeId, status, deletedAt, startDate])
  // Same shape, scoped by capacity (the 1-on-1 tab and its preview).
  @@index([maxMembers, status, deletedAt, startDate])
}

model CrewActivityMember {
  userId     String
  activityId String
  joinedAt   DateTime         @default(now())
  status     CrewMemberStatus @default(MEMBER)
  activity   CrewActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, activityId])
  @@index([userId])
  @@index([activityId])
  @@index([activityId, status])
}

model ActivityDiscussionMessage {
  id         String       @id @default(uuid())
  activityId String
  userId     String
  text       String
  createdAt  DateTime     @default(now())
  activity   CrewActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Primary retrieval pattern: newest-first messages for an activity, cursor-paginated.
  @@index([activityId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId])
}

/// Official campus events published by Campus Representatives (fests, workshops,
/// hackathons, seminars, club/department/sports/cultural events). Distinct from the
/// user-generated CrewActivity model. Expiry is time-derived (see status flow).
model CampusEvent {
  id              String            @id @default(uuid())
  campusId        String
  title           String
  description     String?           @db.VarChar(4000)
  posterUrl       String?
  posterMediaId   String?
  eventDate       DateTime
  startTime       DateTime
  endTime         DateTime
  hostedBy        String
  venue           String?
  registrationUrl String?
  createdBy       String
  status          CampusEventStatus @default(DRAFT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  campus          College           @relation(fields: [campusId], references: [id])
  poster          Media?            @relation("CampusEventPoster", fields: [posterMediaId], references: [id])
  creator         User              @relation("CampusEventCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  // Upcoming/ongoing discovery: WHERE campusId=? AND status=? ORDER BY startTime.
  @@index([campusId, status, startTime])
  // Ongoing/past discovery + auto-expire sweep: filter/sort by endTime.
  @@index([campusId, status, endTime])
  @@index([createdBy])
  @@index([deletedAt, campusId, status, startTime])
}

model Notification {
  id          String                  @id @default(uuid())
  actorId     String?
  entityId    String?
  createdAt   DateTime                @default(now())
  type        NotificationType
  entityType  NotificationEntityType?
  body        String?
  deletedAt   DateTime?
  expiresAt   DateTime?
  metadata    Json?
  readAt      DateTime?
  recipientId String
  title       String?
  updatedAt   DateTime                @updatedAt
  actor       User?                   @relation("NotificationActor", fields: [actorId], references: [id])
  recipient   User                    @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, actorId, entityId, type])
  @@index([recipientId, readAt])
  @@index([recipientId, deletedAt, readAt])
  @@index([recipientId, deletedAt, createdAt(sort: Desc)])
  @@index([recipientId, type, deletedAt, createdAt(sort: Desc)])
  @@index([recipientId, deletedAt, type, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([type])
}

model PostBookmark {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
}

model ActivityBookmark {
  id         String       @id @default(uuid())
  userId     String
  activityId String
  createdAt  DateTime     @default(now())
  activity   CrewActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
  @@index([userId])
  @@index([activityId])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
}

model PostShare {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postId])
  @@index([postId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Mute {
  id         String         @id @default(uuid())
  muterId    String
  targetType MuteTargetType
  targetId   String
  createdAt  DateTime       @default(now())
  muter      User           @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)

  @@unique([muterId, targetType, targetId])
  @@index([muterId])
}

model Hashtag {
  id        String        @id @default(uuid())
  name      String        @unique
  postCount Int           @default(0)
