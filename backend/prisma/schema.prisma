generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model College {
  id            String          @id @default(uuid())
  name          String
  shortName     String?
  slug          String?         @unique
  logoKey       String?
  logoMediaId   String?
  bannerKey     String?
  bannerMediaId String?
  city          String?
  state         String?
  country       String?
  isActive      Boolean         @default(true)
  isVerified    Boolean         @default(false)
  isPrivate     Boolean         @default(false)
  status        CollegeStatus   @default(APPROVED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  bannerMedia   Media?          @relation("CollegeBanner", fields: [bannerMediaId], references: [id])
  logoMedia     Media?          @relation("CollegeLogo", fields: [logoMediaId], references: [id])
  domains       CollegeDomain[]
  communities   Community[]     @relation("CommunityCollege")
  activities    CrewActivity[]  @relation("ActivityCollege")
  users         User[]

  @@index([status])
  @@index([isActive])
  @@index([deletedAt])
}

model CollegeDomain {
  id         String       @id @default(uuid())
  domain     String       @unique
  collegeId  String
  isPrimary  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  isVerified Boolean      @default(true)
  status     DomainStatus @default(ACTIVE)
  updatedAt  DateTime     @updatedAt
  college    College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([collegeId, isPrimary])
  @@index([status])
  @@index([domain, status])
}

model UserSettings {
  id                String  @id @default(uuid())
  userId            String  @unique
  emailNotifs       Boolean @default(true)
  pushNotifs        Boolean @default(false)
  privateProfile    Boolean @default(false)
  showOnlineStatus  Boolean @default(true)
  showLastSeen      Boolean @default(true)
  whoCanSeeOnline   String  @default("everyone")
  whoCanSeeLastSeen String  @default("everyone")
  readReceipts      Boolean @default(true)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreferences {
  id         String   @id @default(uuid())
  userId     String   @unique
  likes      Boolean  @default(true)
  comments   Boolean  @default(true)
  mentions   Boolean  @default(true)
  messages   Boolean  @default(true)
  activities Boolean  @default(true)
  groups     Boolean  @default(true)
  system     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Media {
  id                  String         @id @default(uuid())
  provider            String         @default("supabase")
  bucket              String         @default("meetifyy-dev")
  objectKey           String         @unique
  storageKey          String?
  type                String?
  mimeType            String         @default("application/octet-stream")
  fileSize            Int            @default(0)
  checksum            String?
  width               Int?
  height              Int?
  duration            Int?
  visibility          String         @default("public")
  order               Int            @default(0)
  ownerId             String
  postId              String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  bannerColleges      College[]      @relation("CollegeBanner")
  logoColleges        College[]      @relation("CollegeLogo")
  avatarCommunities   Community[]    @relation("CommunityAvatar")
  coverCommunities    Community[]    @relation("CommunityCover")
  avatarConversations Conversation[] @relation("ConversationAvatar")
  coverActivities     CrewActivity[] @relation("ActivityCover")
  owner               User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  post                Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  messageAttachments  Message[]      @relation("MessageAttachment")
  avatarUsers         User[]         @relation("UserAvatar")
  coverUsers          User[]         @relation("UserCover")

  @@index([postId])
}

model User {
  id                       String                    @id @default(uuid())
  username                 String                    @unique
  displayName              String
  email                    String                    @unique
  bio                      String?
  major                    String?
  location                 String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  avatar                   String?
  avatarMediaId            String?
  collegeEmail             String?
  collegeId                String?
  cover                    String?
  coverMediaId             String?
  deletedAt                DateTime?
  emailVerified            Boolean                   @default(false)
  graduationYear           Int?
  birthday                 String?
  interests                String[]
  lastSeenAt               DateTime?
  phoneVerified            Boolean                   @default(false)
  profileCompleted         Boolean                   @default(false)
  accountStatus            AccountStatus             @default(ACTIVE)
  role                     UserRole                  @default(USER)
  canPost                  Boolean                   @default(true)
  canMessage               Boolean                   @default(true)
  canActivity              Boolean                   @default(true)
  activityBookmarks        ActivityBookmark[]
  invitationsReceived      ActivityInvitation[]      @relation("ActivityInvitationsReceived")
  invitationsSent          ActivityInvitation[]      @relation("ActivityInvitationsSent")
  blocksReceived           Block[]                   @relation("Blocked")
  blocksMade               Block[]                   @relation("Blocker")
  comments                 Comment[]
  commentLikes             CommentLike[]
  ownedCommunities         Community[]               @relation("CommunityOwner")
  communityJoinRequests    CommunityJoinRequest[]
  communityMembers         CommunityMember[]
  ownedConversations       Conversation[]            @relation("ConversationOwner")
  groupJoinRequests        ConversationJoinRequest[]
  conversationParticipants ConversationParticipant[]
  crewActivitiesCreated    CrewActivity[]            @relation("ActivityCreator")
  crewActivities           CrewActivityMember[]
  deletedMessages          DeletedMessage[]
  following                Follow[]                  @relation("follower")
  followers                Follow[]                  @relation("following")
  matchQueueEntry          MatchQueueEntry?
  matchesAsA               MatchSession[]            @relation("MatchUserA")
  matchesAsB               MatchSession[]            @relation("MatchUserB")
  media                    Media[]
  mentions                 Mention[]                 @relation("MentionedUser")
  sentMessages             Message[]
  messageReactions         MessageReaction[]
  mutesMade                Mute[]                    @relation("Muter")
  actorNotifications       Notification[]            @relation("NotificationActor")
  notifications            Notification[]            @relation("NotificationRecipient")
  notificationPrefs        NotificationPreferences?
  pollVotes                PollVote[]
  posts                    Post[]
  bookmarks                PostBookmark[]
  likes                    PostLike[]
  shares                   PostShare[]
  recentSearches           RecentSearch[]
  reportsMade              Report[]                  @relation("Reporter")
  supportTickets           SupportTicket[]
  avatarMedia              Media?                    @relation("UserAvatar", fields: [avatarMediaId], references: [id])
  college                  College?                  @relation(fields: [collegeId], references: [id])
  coverMedia               Media?                    @relation("UserCover", fields: [coverMediaId], references: [id])
  settings                 UserSettings?

  @@index([collegeId])
  @@index([collegeId, createdAt(sort: Desc)])
  @@index([deletedAt, createdAt])
  @@index([lastSeenAt])
  @@index([createdAt])
}

model Post {
  id           String         @id @default(uuid())
  authorId     String
  communityId  String?
  text         String         @db.VarChar(2000)
  likeCount    Int            @default(0)
  commentCount Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  comments     Comment[]
  media        Media[]
  pollOptions  PollOption[]
  pollVotes    PollVote[]
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community    Community?     @relation(fields: [communityId], references: [id])
  bookmarks    PostBookmark[]
  hashtags     PostHashtag[]
  likes        PostLike[]
  shares       PostShare[]

  @@index([authorId])
  @@index([createdAt])
  @@index([deletedAt, createdAt])
  @@index([authorId, deletedAt, createdAt(sort: Desc)])
  @@index([deletedAt, createdAt(sort: Desc), authorId])
  @@index([communityId, deletedAt, createdAt(sort: Desc)])
}

model PostLike {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Comment {
  id             String        @id @default(uuid())
  postId         String
  authorId       String
  text           String        @db.VarChar(500)
  parentId       String?
  likeCount      Int           @default(0)
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?
  isDeleted      Boolean       @default(false)
  deletedByUser  Boolean       @default(false)
  removalReason  String?       @db.VarChar(200)
  removedByOwner Boolean       @default(false)
  author         User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent         Comment?      @relation("replies", fields: [parentId], references: [id])
  replies        Comment[]     @relation("replies")
  post           Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes          CommentLike[]

  @@index([postId])
  @@index([postId, createdAt])
  @@index([authorId])
  @@index([isDeleted, postId])
  @@index([deletedAt, createdAt])
}

model CommentLike {
  userId    String
  commentId String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([userId])
  @@index([commentId])
}

model Community {
  id                String                 @id @default(uuid())
  name              String
  slug              String                 @unique
  description       String?
  avatarKey         String?
  avatarMediaId     String?
  coverKey          String?
  coverMediaId      String?
  color             String?
  isPrivate         Boolean                @default(false)
  memberCount       Int                    @default(0)
  createdAt         DateTime               @default(now())
  deletedAt         DateTime?
  ownerId           String?
  updatedAt         DateTime               @updatedAt
  collegeId         String?
  isCampusCommunity Boolean                @default(false)
  avatarMedia       Media?                 @relation("CommunityAvatar", fields: [avatarMediaId], references: [id])
  college           College?               @relation("CommunityCollege", fields: [collegeId], references: [id])
  coverMedia        Media?                 @relation("CommunityCover", fields: [coverMediaId], references: [id])
  owner             User?                  @relation("CommunityOwner", fields: [ownerId], references: [id])
  joinRequests      CommunityJoinRequest[]
  members           CommunityMember[]
  posts             Post[]

  @@index([ownerId])
  @@index([deletedAt, memberCount(sort: Desc)])
  @@index([deletedAt, isCampusCommunity, memberCount(sort: Desc)])
  @@index([collegeId, isCampusCommunity, deletedAt, memberCount(sort: Desc)])
}

model CommunityMember {
  userId      String
  communityId String
  joinedAt    DateTime      @default(now())
  role        CommunityRole @default(MEMBER)
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, communityId])
  @@index([userId])
  @@index([communityId])
  @@index([communityId, role])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([followingId, createdAt(sort: Desc)])
  @@index([followerId, createdAt(sort: Desc)])
}

model Conversation {
  id                  String                    @id @default(uuid())
  publicId            String?                   @unique
  name                String?
  avatarKey           String?
  avatarMediaId       String?
  isPrivate           Boolean                   @default(false)
  ownerId             String?
  createdAt           DateTime                  @default(now())
  allowSharing        Boolean                   @default(true)
  editGroupPermission String                    @default("ADMIN")
  visibility          String                    @default("PUBLIC")
  whoCanJoin          String                    @default("ANYONE")
  description         String?
  inviteCode          String?
  inviteLink          String?
  memberCount         Int                       @default(0)
  pinnedMessageId     String?
  isInstantMatch      Boolean                   @default(false)
  expiresAt           DateTime?
  isActivityChat      Boolean                   @default(false)
  activityId          String?                   @unique
  status              String                    @default("ACTIVE")
  lastMessageId       String?
  lastMessageText     String?
  lastMessageType     String?
  lastMessageAt       DateTime?
  lastMessageSenderId String?
  updatedAt           DateTime                  @updatedAt
  type                ConversationType
  activity            CrewActivity?             @relation("ActivityConversation", fields: [activityId], references: [id])
  avatarMedia         Media?                    @relation("ConversationAvatar", fields: [avatarMediaId], references: [id])
  owner               User?                     @relation("ConversationOwner", fields: [ownerId], references: [id])
  pinnedMessage       Message?                  @relation("PinnedMessage", fields: [pinnedMessageId], references: [id])
  joinRequests        ConversationJoinRequest[]
  participants        ConversationParticipant[]
  messages            Message[]                 @relation("ConversationMessages")

  @@index([ownerId])
  @@index([activityId])
  @@index([updatedAt(sort: Desc)])
}

model ConversationParticipant {
  userId             String
  conversationId     String
  joinedAt           DateTime         @default(now())
  role               ConversationRole @default(MEMBER)
  lastReadAt         DateTime?
  isMuted            Boolean          @default(false)
  isPinned           Boolean          @default(false)
  groupUpdatesActive Boolean          @default(true)
  unreadCount        Int              @default(0)
  clearedAt          DateTime?
  leftAt             DateTime?
  deletedAt          DateTime?
  conversation       Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
  @@index([userId, deletedAt])
  @@index([userId, deletedAt, leftAt])
  @@index([conversationId, deletedAt])
  @@index([conversationId, deletedAt, userId])
  @@index([conversationId, deletedAt, leftAt, userId])
}

model Message {
  id                String                   @id @default(uuid())
  clientMessageId   String?
  conversationId    String
  senderId          String
  createdAt         DateTime                 @default(now())
  deletedAt         DateTime?
  editedAt          DateTime?
  payload           Json?
  replyToId         String?
  pinnedIn          Conversation[]           @relation("PinnedMessage")
  deletedByUsers    DeletedMessage[]
  type              MessageType              @default(CHAT)
  state             MessageState             @default(NORMAL)
  attachmentMediaId String?
  attachmentMedia   Media?                   @relation("MessageAttachment", fields: [attachmentMediaId], references: [id])
  conversation      Conversation             @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo           Message?                 @relation("MessageReplies", fields: [replyToId], references: [id])
  replies           Message[]                @relation("MessageReplies")
  sender            User                     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions         MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([conversationId, createdAt, senderId])
  @@index([conversationId, deletedAt, createdAt(sort: Desc)])
  @@index([conversationId, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index([senderId])
  @@index([senderId, clientMessageId])
}

model CrewActivity {
  id                  String                @id @default(uuid())
  creatorId           String
  title               String
  description         String?
  location            String?
  maxMembers          Int?
  createdAt           DateTime              @default(now())
  coverImage          String?
  coverMediaId        String?
  createActivityGroup Boolean               @default(false)
  deletedAt           DateTime?
  endDate             DateTime?
  latitude            Float?
  longitude           Float?
  startDate           DateTime?
  status              CrewActivityStatus    @default(OPEN)
  updatedAt           DateTime              @updatedAt
  hostCollege         String?
  collegeId           String?
  participationType   CrewParticipationType @default(OPEN)
  shareToCampus       Boolean               @default(false)
  visibility          ActivityVisibility    @default(PUBLIC)
  bookmarks           ActivityBookmark[]
  invitations         ActivityInvitation[]
  conversation        Conversation?         @relation("ActivityConversation")
  college             College?              @relation("ActivityCollege", fields: [collegeId], references: [id])
  coverMedia          Media?                @relation("ActivityCover", fields: [coverMediaId], references: [id])
  creator             User                  @relation("ActivityCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members             CrewActivityMember[]

  @@index([creatorId])
  @@index([createdAt])
  @@index([status])
  @@index([deletedAt, status, createdAt])
  @@index([status, createdAt(sort: Desc)])
  @@index([collegeId, status, createdAt(sort: Desc)])
  @@index([visibility, status, createdAt(sort: Desc)])
  @@index([deletedAt, status, visibility, createdAt(sort: Desc)])
  @@index([status, deletedAt, endDate, startDate])
}

model CrewActivityMember {
  userId     String
  activityId String
  joinedAt   DateTime         @default(now())
  status     CrewMemberStatus @default(MEMBER)
  activity   CrewActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, activityId])
  @@index([userId])
  @@index([activityId])
}

model Notification {
  id          String                  @id @default(uuid())
  actorId     String?
  entityId    String?
  createdAt   DateTime                @default(now())
  type        NotificationType
  entityType  NotificationEntityType?
  body        String?
  deletedAt   DateTime?
  expiresAt   DateTime?
  metadata    Json?
  readAt      DateTime?
  recipientId String
  title       String?
  updatedAt   DateTime                @updatedAt
  actor       User?                   @relation("NotificationActor", fields: [actorId], references: [id])
  recipient   User                    @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, actorId, entityId, type])
  @@index([recipientId, readAt])
  @@index([recipientId, deletedAt, readAt])
  @@index([recipientId, deletedAt, createdAt(sort: Desc)])
  @@index([recipientId, type, deletedAt, createdAt(sort: Desc)])
  @@index([recipientId, deletedAt, type, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([type])
}

model PostBookmark {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
}

model ActivityBookmark {
  id         String       @id @default(uuid())
  userId     String
  activityId String
  createdAt  DateTime     @default(now())
  activity   CrewActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
  @@index([userId])
  @@index([activityId])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
}

model PostShare {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postId])
  @@index([postId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Mute {
  id         String         @id @default(uuid())
  muterId    String
  targetType MuteTargetType
  targetId   String
  createdAt  DateTime       @default(now())
  muter      User           @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)

  @@unique([muterId, targetType, targetId])
  @@index([muterId])
}

model Hashtag {
  id        String        @id @default(uuid())
  name      String        @unique
  postCount Int           @default(0)
  createdAt DateTime      @default(now())
  posts     PostHashtag[]
}

model PostHashtag {
  postId    String
  hashtagId String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId])
}

model Mention {
  id         String        @id @default(uuid())
  userId     String
  sourceType MentionSource
  sourceId   String
  createdAt  DateTime      @default(now())
  user       User          @relation("MentionedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sourceType, sourceId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model PollOption {
  id        String     @id @default(uuid())
  postId    String
  text      String
  voteCount Int        @default(0)
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@index([postId])
}

model PollVote {
  id        String     @id @default(uuid())
  postId    String
  optionId  String
  userId    String
  createdAt DateTime   @default(now())
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([optionId])
  @@index([userId])
}

model Report {
  id                  String           @id @default(uuid())
  reporterId          String
  targetType          ReportTargetType
  targetId            String
  reason              ReportReason
  description         String?          @db.VarChar(500)
  metadata            Json?
  status              ReportStatus     @default(PENDING)
  priority            ReportPriority   @default(MEDIUM)
  assignedModeratorId String?
  internalNotes       String?          @db.VarChar(2000)
  actionTaken         String?          @db.VarChar(500)
  resolution          String?          @db.VarChar(500)
  resolvedAt          DateTime?
  resolvedBy          String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  reporter            User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([priority, status])
}

model MatchQueueEntry {
  id             String   @id @default(uuid())
  userId         String   @unique
  campus         String
  activity       String
  timePreference String
  optionalDetail String?
  area           String?
  latitude       Float?
  longitude      Float?
  joinedAt       DateTime @default(now())
  expiresAt      DateTime
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campus, activity, timePreference])
}

model MatchSession {
  id             String      @id @default(uuid())
  userAId        String
  userBId        String
  activity       String
  status         MatchStatus @default(PENDING)
  aAccepted      Boolean     @default(false)
  bAccepted      Boolean     @default(false)
  conversationId String?
  createdAt      DateTime    @default(now())
  expiresAt      DateTime
  userA          User        @relation("MatchUserA", fields: [userAId], references: [id])
  userB          User        @relation("MatchUserB", fields: [userBId], references: [id])

  @@index([userAId])
  @@index([userBId])
}

model SuperAdmin {
  id            String              @id @default(uuid())
  email         String              @unique
  passwordHash  String
  name          String
  isActive      Boolean             @default(true)
  totpSecret    String?
  totpEnabled   Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  otps          AdminOtp[]
  recoveryCodes AdminRecoveryCode[]
  auditLogs     AuditLog[]
  loginAudits   LoginAudit[]
  sessions      SuperAdminSession[]
}

model SuperAdminSession {
  id            String     @id @default(uuid())
  adminId       String
  refreshHash   String     @unique
  ip            String?
  userAgent     String?
  deviceName    String?
  browser       String?
  os            String?
  lastActiveAt  DateTime   @default(now())
  expiresAt     DateTime
  createdAt     DateTime   @default(now())
  revoked       Boolean    @default(false)
  revokedReason String?
  admin         SuperAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@index([revoked])
}

model AdminOtp {
  id        String     @id @default(uuid())
  adminId   String
  otpHash   String
  attempts  Int        @default(0)
  expiresAt DateTime
  used      Boolean    @default(false)
  createdAt DateTime   @default(now())
  admin     SuperAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model AdminRecoveryCode {
  id        String     @id @default(uuid())
  adminId   String
  codeHash  String
  used      Boolean    @default(false)
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  admin     SuperAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model LoginAudit {
  id            String      @id @default(uuid())
  adminId       String?
  email         String
  success       Boolean
  ip            String?
  userAgent     String?
  deviceName    String?
  browser       String?
  os            String?
  failureReason String?
  createdAt     DateTime    @default(now())
  admin         SuperAdmin? @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@index([success])
}

model AuditLog {
  id         String     @id @default(uuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  oldValue   Json?
  newValue   Json?
  ip         String?
  endpoint   String?
  httpMethod String?
  requestId  String?
  createdAt  DateTime   @default(now())
  admin      SuperAdmin @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([action])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  type      String
  ip        String?
  adminId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model SupportTicket {
  id         String           @id @default(uuid())
  userId     String
  category   SupportCategory
  subject    String
  status     SupportStatus    @default(OPEN)
  priority   ReportPriority   @default(MEDIUM)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  resolvedAt DateTime?
  messages   SupportMessage[]
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SupportMessage {
  id          String        @id @default(uuid())
  ticketId    String
  senderId    String?
  body        String        @db.VarChar(5000)
  isInternal  Boolean       @default(false)
  attachments Json?
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model CollegeRequest {
  id            String   @id @default(uuid())
  name          String
  collegeName   String
  personalEmail String?
  collegeEmail  String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Announcement {
  id          String             @id @default(uuid())
  title       String
  body        String             @db.VarChar(10000)
  target      AnnouncementTarget @default(ALL)
  collegeId   String?
  method      AnnouncementMethod @default(IN_APP)
  status      AnnouncementStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  cancelledAt DateTime?
  sentCount   Int                @default(0)
  failedCount Int                @default(0)
  createdAt   DateTime           @default(now())

  @@index([status])
  @@index([scheduledAt])
}

model FeatureFlag {
  id                String   @id @default(uuid())
  key               String   @unique
  enabled           Boolean  @default(true)
  description       String?
  rolloutPercentage Int      @default(100)
  updatedAt         DateTime @updatedAt
}

model SystemSetting {
  key         String   @id
  value       String
  type        String
  description String?
  updatedAt   DateTime @updatedAt
}

model ConversationJoinRequest {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  expiresAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model DeletedMessage {
  id        String   @id @default(uuid())
  userId    String
  messageId String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
  @@index([messageId])
}

model ActivityInvitation {
  id          String                   @id @default(uuid())
  activityId  String
  inviterId   String
  inviteeId   String
  status      ActivityInvitationStatus @default(PENDING)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  respondedAt DateTime?
  activity    CrewActivity             @relation(fields: [activityId], references: [id], onDelete: Cascade)
  invitee     User                     @relation("ActivityInvitationsReceived", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviter     User                     @relation("ActivityInvitationsSent", fields: [inviterId], references: [id], onDelete: Cascade)

  @@unique([activityId, inviteeId])
  @@index([activityId, inviteeId])
  @@index([activityId, inviteeId, status])
  @@index([inviteeId, status])
  @@index([inviteeId, status, createdAt(sort: Desc)])
  @@index([inviterId])
  @@index([activityId, status])
}

model CommunityJoinRequest {
  id          String                 @id @default(uuid())
  communityId String
  userId      String
  status      CommunityRequestStatus @default(PENDING)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  community   Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId, status])
  @@index([userId])
}

model RecentSearch {
  id        String   @id @default(uuid())
  userId    String
  term      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, term])
  @@index([userId, updatedAt(sort: Desc)])
}

