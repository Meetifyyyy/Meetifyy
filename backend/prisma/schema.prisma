model MatchSession {
  id             String                 @id @default(uuid())
  userAId        String
  userBId        String
  activity       String
  status         MatchStatus            @default(PENDING)
  aAccepted      Boolean                @default(false)
  bAccepted      Boolean                @default(false)
  conversationId String?
  createdAt      DateTime               @default(now())
  expiresAt      DateTime
  /// ─── Chat lifecycle ──────────────────────────────────────────────────
  /// The server is the sole authority on whether messaging is still allowed.
  /// A client's countdown is presentation only; every write re-checks these.
  chatStatus     InstantMatchChatStatus @default(ACTIVE)
  /// When the 24h conversation window closes. Stamped at accept time, so
  /// expiry does not depend on anyone sending a message.
  chatExpiresAt  DateTime?
  /// Who walked away, and when. Null while the chat is live.
  endedById      String?
  endedAt        DateTime?
  /// The shared interest the pair was matched on, kept on the session so the
  /// chat header can explain itself without re-deriving it from the queue
  /// snapshots (which are cleared once the match is made).
  matchReason    String?
  /// Snapshot of each side's original queue request, so the server can
  /// re-queue the other user when a match is declined or times out without
  /// depending on that client still being connected to replay it.
  snapshotA      Json?
  snapshotB      Json?
  userA          User                   @relation("MatchUserA", fields: [userAId], references: [id])
  userB          User                   @relation("MatchUserB", fields: [userBId], references: [id])

  @@index([userAId])
  @@index([userBId])
  @@index([status, expiresAt])
  /// Serves "does this user have a live instant-match chat?" — the question
  /// asked on every Instant Match screen load and every message send.
  @@index([chatStatus, chatExpiresAt])
  @@index([conversationId])
}

