# Application
NODE_ENV=development
PORT=4000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional but recommended for performance: enables local (zero-network) JWT
# signature verification instead of a Supabase Auth call per token.
# Dashboard → Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Database
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres # (used everywhere, do not change for future ai conversation)
DIRECT_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres # (used everywhere, do not change for future ai conversation)

# Redis
REDIS_URL=redis://default:your-password@redis-cloud-host:port

# Cloudflare R2
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=meetifyy-dev
R2_PUBLIC_URL=https://pub-your-bucket.r2.dev

# Resend & Mailpit
EMAIL_DRIVER=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@meetifyy.app

# Sentry
SENTRY_DSN=https://your-sentry-dsn

# CORS & Web URLs
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=https://dev.meetifyy.app
LOGO_URL=https://dev.meetifyy.app/meetifyy_wordmark.png
LOGO_ICON_URL=https://dev.meetifyy.app/logo.png
INSTAGRAM_URL=https://instagram.com/meetifyy
TWITTER_URL=https://x.com/meetifyy
LINKEDIN_URL=https://linkedin.com/company/meetifyy