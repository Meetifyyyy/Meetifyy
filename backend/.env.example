# =============================================================================
# Meetifyy Backend — environment template
# =============================================================================
# Copy to .env.local (developer-specific, git-ignored) and fill in real values.
# Every variable the backend reads is listed here; nothing is hardcoded in src/.
#
# Load order (first hit wins):
#   process env  →  .env.<APP_ENV>.local  →  .env.local  →  .env.<APP_ENV>  →  .env
#
# All of these are SERVER-ONLY and RUNTIME values. None of them are ever sent to
# a browser.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Distinguishes staging from production when both build with NODE_ENV=production.
# One of: development | test | staging | production. Defaults to NODE_ENV.
APP_ENV=development
APP_NAME=Meetifyy
APP_VERSION=0.9.0
HOST=0.0.0.0
PORT=4000

# ── Public URLs (required) ───────────────────────────────────────────────────
# Every generated link — emails, auth redirects, notifications — derives from
# these. Required in all environments: FRONTEND_URL.
FRONTEND_URL=http://localhost:3000
# Required in staging/production. API_BASE_URL defaults to BACKEND_URL + /api.
BACKEND_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000/api
ADMIN_URL=http://localhost:5174

# ── CORS ─────────────────────────────────────────────────────────────────────
# FRONTEND_URL and ADMIN_URL are trusted automatically; list any extra origins.
CORS_ORIGINS=
# Wildcard origins for preview deployments, e.g. https://*.vercel.app
CORS_ORIGIN_PATTERNS=
# Trust localhost / private-LAN origins (for testing from a phone on the same
# Wi-Fi). Forced off in production regardless of this value.
CORS_ALLOW_LOCAL_NETWORK=true
# How long a browser may reuse one CORS preflight result (seconds, max 86400).
# Every API call carries an Authorization header and is therefore preceded by an
# OPTIONS preflight; without this the round trip is paid twice on every request.
# Lower it if the allowed methods/headers ever need to change quickly.
CORS_MAX_AGE_SECONDS=86400

# ── Security headers ─────────────────────────────────────────────────────────
# Both default to on in production, off elsewhere.
CSP_ENABLED=
HSTS_ENABLED=
# Extra allowed sources per directive, comma-separated. 'self' is always added.
CSP_SCRIPT_SRC=
CSP_STYLE_SRC=
CSP_FONT_SRC=
CSP_IMG_SRC=
CSP_CONNECT_SRC=

# ── Cookies ──────────────────────────────────────────────────────────────────
# Leave COOKIE_DOMAIN empty for host-only cookies (correct for localhost and
# single-domain deployments). Use a leading dot to share across subdomains.
COOKIE_DOMAIN=
COOKIE_SECURE=false
# strict | lax | none  ("none" requires COOKIE_SECURE=true)
COOKIE_SAME_SITE=strict

# ── Database (required everywhere) ───────────────────────────────────────────
# DATABASE_URL is used at runtime; DIRECT_URL is used for migrations.
# Development and production MUST point at separate databases.
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres
DB_SLOW_QUERY_MS=500
DB_CONNECTION_RETRIES=3
# Seeding deletes every row. Refused in production unless explicitly enabled.
ALLOW_DESTRUCTIVE_SEED=

# ── Supabase / auth provider ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Required in staging/production. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional but recommended: enables local (zero-network) JWT signature
# verification instead of a Supabase Auth call per token.
# Dashboard → Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=

# ── Auth redirect paths (appended to FRONTEND_URL) ───────────────────────────
AUTH_CALLBACK_PATH=/auth/callback
AUTH_LOGIN_PATH=/login
AUTH_SIGNUP_PATH=/signup
AUTH_RESET_PASSWORD_PATH=/reset-password
AUTH_VERIFY_EMAIL_PATH=/verify-email
AUTH_DASHBOARD_PATH=/home

# ── Admin authentication (required in staging/production) ────────────────────
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=
ADMIN_JWT_PENDING_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Redis / queues ───────────────────────────────────────────────────────────
# REDIS_URL takes precedence; the discrete fields are the fallback.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# Queue key namespace, defaulting to "bull:<APP_ENV>". This is what stops a
# local worker from consuming another environment's jobs when both point at
# the same Redis instance. Only set it to separate two deployments of the
# SAME environment (per-PR previews, blue/green).
REDIS_QUEUE_PREFIX=

# ── Storage ──────────────────────────────────────────────────────────────────
# r2 | supabase | local
# Cloudflare R2 is the only supported storage backend.
STORAGE_PROVIDER=r2
# Public origin media is served from. Without it, media falls back to /api/media.
STORAGE_PUBLIC_URL=
STORAGE_REGION=auto
STORAGE_SIGNED_URL_TTL=3600
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Required in staging/production. The meetifyy-dev
# fallback applies to local development only — a deployed environment that
# omitted this used to silently read and write the DEVELOPMENT bucket.
R2_BUCKET_NAME=meetifyy-dev

# Optional separate bucket for account-verification documents (selfie + college ID).
#
# The main bucket is fronted by a public `pub-*.r2.dev` host, which serves ANY
# key with no authentication — so for identity documents, privacy there rests
# entirely on the object key being unguessable. Point this at a bucket with NO
# public host and verification objects become reachable only through a signed
# URL issued to an authorised reviewer.
#
# Leave unset to keep everything in R2_BUCKET_NAME (existing behaviour).
# R2_VERIFICATION_BUCKET_NAME=meetifyy-verification

# How long a verification upload that was never submitted is left alone before
# it is collected. Submitted documents are retained indefinitely and are never
# touched by this — it only covers files from an abandoned form, which nothing
# references and no other cleanup path can see. Default 24h; the grace period
# exists so an in-progress submission is never mistaken for an abandoned one.
# VERIFICATION_ABANDONED_UPLOAD_HOURS=24

R2_PUBLIC_URL=

# ── Email ────────────────────────────────────────────────────────────────────
# mailpit | smtp | resend   ("mailpit" is refused in staging and production)
# Local development must stay on "mailpit": it is the only value that keeps
# mail off the real internet.
# ── Two independent email paths ──────────────────────────────────────
#
# 1. Supabase auth email (signup confirmation, password reset, magic link)
#    goes out through Supabase, configured in the Supabase dashboard under
#    Authentication -> SMTP Settings. Point that at Brevo. Nothing in this
#    file affects it, and the backend must never send those itself or the
#    user gets two of each.
#
# 2. Application email (welcome, new sign-in, password changed, support)
#    is queued by the backend and sent by EmailProcessor. That is what the
#    variables below configure: Resend as primary, Brevo as the relay it
#    falls back to.
#
# The fallback is deliberately not used for every failure. It fires when
# Resend reports it did not send (quota, rate limit, 5xx, unreachable). It
# is skipped on a timeout, where Resend may have sent the message already
# and retrying would duplicate it, and on a rejected address, which Brevo
# would reject too. Search the logs for `email.failover_skipped` to see it.
EMAIL_DRIVER=mailpit
# Optional SMTP fallback for the primary driver. When set to "smtp" and the
# primary send fails, the job retries once via the SMTP transporter before the
# job is marked failed. Leave empty (default) to disable. Only meaningful in
# production with EMAIL_DRIVER=resend; requires SMTP_HOST/USER/PASS to be set.
EMAIL_FALLBACK_DRIVER=
# Optional, reporting only: a Brevo REST API key (NOT the SMTP key) lets the
# admin analytics panel show Brevo's own daily figures and remaining credits.
# Mail sends perfectly well without it; absent means the panel omits those rows.
BREVO_API_KEY=
EMAIL_FROM=noreply@example.test
EMAIL_FROM_NAME=Meetifyy
EMAIL_REPLY_TO=
# From header for security mail (admin OTP, password changed). Defaults to
# "<EMAIL_FROM_NAME> Security <EMAIL_FROM>".
EMAIL_SECURITY_FROM=
# Development safety valve: redirect ALL outgoing mail to this address.
# Ignored in staging and production, which always mail the real recipient.
# Shared secret for the /dev/email/* preview routes. When empty they are
# reachable from loopback only; set it to reach them from another device.
DEV_ENDPOINT_TOKEN=
DEV_EMAIL_REDIRECT=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Required when EMAIL_DRIVER=resend. The domain in EMAIL_FROM must be verified
# on the Resend account or every send is refused with a 403; the driver checks
# this once at boot and logs `email.domain_unverified` if it is not.
RESEND_API_KEY=
# Legacy fallback for EMAIL_FROM, kept for older deployments. Prefer EMAIL_FROM.
RESEND_FROM_EMAIL=

# ── Branding / site links (used in emails and notifications) ─────────────────
# Logos default to assets served by the frontend itself.
WORDMARK_URL=https://pub-8cd64731b2bc47deb8a54acbbbfa9c4b.r2.dev/email-assets/wordmark.png
LOGO_URL=
LOGO_ICON_URL=
LOGO_WHITE_URL=
ICON_INSTAGRAM_URL=
ICON_LINKEDIN_URL=
ICON_WEBSITE_URL=
ICON_SHIELD_URL=
INSTAGRAM_URL=https://www.instagram.com/meetifyy.in?igsi=YzVoZ3drN29id2tn
LINKEDIN_URL=https://www.linkedin.com/company/meetifyy/
# Support page link shown in emails. Defaults to /help-and-support on FRONTEND_URL.
SUPPORT_URL=
PRIVACY_PATH=/privacy-policy
TERMS_PATH=/terms-and-conditions
PASSWORD_RESET_EXPIRY_MINUTES=10
OTP_EXPIRY_MINUTES=10

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
# 0..1. Default 0.1 traces / 0.05 profiles in production, 1.0 elsewhere.
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=

# ── Features & logging ───────────────────────────────────────────────────────
# Dev endpoints and debug tools are forced off in production.
FEATURE_DEV_ENDPOINTS=true
FEATURE_DEBUG_TOOLS=true
FEATURE_EXPERIMENTAL=false
FEATURE_RELAXED_RATE_LIMITS=true
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
LOG_PRETTY=true
LOG_QUERIES=true

# ─── Environment isolation ───────────────────────────────────────────────────
# In staging/production the backend refuses to boot if DATABASE_URL, REDIS_URL,
# SUPABASE_URL, the active storage bucket, FRONTEND_URL or ADMIN_URL is named
# like another environment's resource (see backend/src/config/isolation.guard.ts
# and docs/ENVIRONMENT_ISOLATION.md).
#
# Set to true ONLY for a production resource whose name legitimately contains
# "dev". This disables a real safety net — leave it unset.
DEV_RESOURCE_CHECK_DISABLED=
