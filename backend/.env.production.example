# ─────────────────────────────────────────────────────────────────────────────
# Meetifyy backend — PRODUCTION environment
#
# This file is the deployment checklist. Every variable the backend reads is
# listed here, grouped the same way src/config/*.ts groups them. Paste the
# filled-in values into Azure Container Apps → Container App → Secrets /
# Environment Variables.
#
# Legend:
#   [REQUIRED]  the process refuses to boot without it
#   [SECRET]    never commit a real value; set it as a Container App secret
#   (default: x) what you get when the variable is absent — safe to leave blank
#
# Anything not marked [REQUIRED] can be omitted entirely. Blank and absent are
# treated identically: the value is trimmed, and an empty string falls back to
# the default.
#
# Load order (earlier wins, files never override the real environment):
#   process env → .env.<APP_ENV>.local → .env.local → .env.<APP_ENV> → .env
# On Azure Container Apps only the first applies; the dotenv files are a local
# convenience only.
# ─────────────────────────────────────────────────────────────────────────────


# ── Environment identity ─────────────────────────────────────────────────────
# APP_ENV is the single switch that tells the backend which environment it is
# in. It selects the email driver, the queue namespace, cookie security, CSP,
# HSTS, log level, and which variables are mandatory.
#
# It MUST be exactly "production" (lowercase). An unrecognised value — "prod",
# "live", a typo — silently falls back to "development", which selects the
# Mailpit email driver and exposes the /dev/* routes. It falls back to
# NODE_ENV when unset, so leaving both blank has the same effect.
APP_ENV=production
NODE_ENV=production

HOST=0.0.0.0
PORT=4000
APP_NAME=Meetifyy
APP_VERSION=0.9.0


# ── Public URLs ──────────────────────────────────────────────────────────────
# Every generated link — emails, auth redirects, notifications — derives from
# these. Must be https:// in production (localhost is the only exception).
# No trailing slash; it is stripped anyway.
FRONTEND_URL=https://meetifyy.app          # [REQUIRED]
BACKEND_URL=https://api.meetifyy.app       # [REQUIRED]

# The admin dashboard origin. This is added to the CORS allow-list, so never
# leave a localhost value here in production — it would let any page served
# from that port on a user's machine make credentialed calls to the live API.
ADMIN_URL=https://admin.meetifyy.app

# Only set this if the API genuinely sits behind a path prefix. The server
# calls no setGlobalPrefix, so routes are served at the root (/health, not
# /api/health); when blank the base is BACKEND_URL itself.
API_BASE_URL=


# ── CORS ─────────────────────────────────────────────────────────────────────
# CORS_ORIGINS is the authoritative allow-list; FRONTEND_URL and ADMIN_URL are
# added automatically. Patterns support a single "*" wildcard per segment.
CORS_ORIGINS=https://meetifyy.app,https://www.meetifyy.app
CORS_ORIGIN_PATTERNS=https://*.meetifyy.app
# (default: true, but forced false in production) Allows LAN/localhost origins.
CORS_ALLOW_LOCAL_NETWORK=


# ── Security headers ─────────────────────────────────────────────────────────
CSP_ENABLED=                 # (default: true in production)
HSTS_ENABLED=                # (default: true in production)
CSP_CONNECT_SRC=wss://api.meetifyy.app
CSP_SCRIPT_SRC=
CSP_STYLE_SRC=
CSP_IMG_SRC=
CSP_FONT_SRC=


# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# DATABASE_URL is the pooled connection used by the app; DIRECT_URL is the
# unpooled one Prisma needs for migrations.
DATABASE_URL=                # [REQUIRED] [SECRET]
DIRECT_URL=                  # [SECRET]
DB_CONNECTION_RETRIES=       # (default: 3)
DB_SLOW_QUERY_MS=            # (default: 500)
# Guards `prisma db seed` against wiping a real database. Never set in prod.
ALLOW_DESTRUCTIVE_SEED=


# ── Supabase / auth ──────────────────────────────────────────────────────────
SUPABASE_URL=                      # [REQUIRED]
SUPABASE_ANON_KEY=                 # [REQUIRED] [SECRET]
SUPABASE_SERVICE_ROLE_KEY=         # [REQUIRED] [SECRET] bypasses every RLS policy
SUPABASE_JWT_SECRET=               # [SECRET]

# Cookies. COOKIE_SECURE defaults to true in production and the process
# refuses to boot if it is false there.
COOKIE_SECURE=
COOKIE_SAME_SITE=                  # strict | lax | none   (default: strict)
COOKIE_DOMAIN=.meetifyy.app

# Super-admin console.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=              # [SECRET] use a long random value
ADMIN_JWT_ACCESS_SECRET=           # [REQUIRED] [SECRET]
ADMIN_JWT_REFRESH_SECRET=          # [REQUIRED] [SECRET]
ADMIN_JWT_PENDING_SECRET=          # [REQUIRED] [SECRET]

# Frontend paths used to build auth links. Defaults shown.
AUTH_CALLBACK_PATH=                # (default: /auth/callback)
AUTH_LOGIN_PATH=                   # (default: /login)
AUTH_SIGNUP_PATH=                  # (default: /signup)
AUTH_RESET_PASSWORD_PATH=          # (default: /reset-password)
AUTH_VERIFY_EMAIL_PATH=            # (default: /verify-email)
AUTH_DASHBOARD_PATH=               # (default: /home)


# ── Redis / BullMQ ───────────────────────────────────────────────────────────
# REDIS_URL is the single-value form every managed provider gives you; the
# discrete fields below are only for setups that expose them separately.
REDIS_URL=                   # [SECRET]
REDIS_HOST=                  # (default: 127.0.0.1)
REDIS_PORT=                  # (default: 6379)
REDIS_PASSWORD=              # [SECRET]
REDIS_TLS=                   # (default: false)

# Queue key namespace. Defaults to "bull:<APP_ENV>", which is what keeps a
# developer's machine from consuming production jobs when both point at the
# same Redis. Only set this to separate two deployments of the SAME
# environment (per-PR previews, blue/green).
REDIS_QUEUE_PREFIX=


# ── Email ────────────────────────────────────────────────────────────────────
# "mailpit" is refused outright in staging and production.
# ── Two independent email paths ──────────────────────────────────────
#
# 1. Supabase auth email (signup confirmation, password reset, magic link)
#    goes out through Supabase, configured in the Supabase dashboard under
#    Authentication -> SMTP Settings. Point that at Brevo. Nothing in this
#    file affects it, and the backend must never send those itself or the
#    user gets two of each.
#
# 2. Application email (welcome, new sign-in, password changed, support)
#    is queued by the backend and sent by EmailProcessor. That is what the
#    variables below configure: Resend as primary, Brevo as the relay it
#    falls back to.
#
# The fallback is deliberately not used for every failure. It fires when
# Resend reports it did not send (quota, rate limit, 5xx, unreachable). It
# is skipped on a timeout, where Resend may have sent the message already
# and retrying would duplicate it, and on a rejected address, which Brevo
# would reject too. Search the logs for `email.failover_skipped` to see it.
EMAIL_DRIVER=resend                      # mailpit | smtp | resend
# Optional SMTP failover. Set to "smtp" to retry a failed Resend send once
# through the SMTP relay below before the job is marked failed. Leave blank to
# disable. When set, SMTP_HOST, SMTP_USER and SMTP_PASS are all required and the
# app refuses to boot without them.
EMAIL_FALLBACK_DRIVER=                   # "" | smtp
# Optional, reporting only: a Brevo REST API key (NOT the SMTP key) lets the
# admin analytics panel show Brevo's own daily figures and remaining credits.
# Mail sends perfectly well without it; absent means the panel omits those rows.
BREVO_API_KEY=

# The domain in EMAIL_FROM MUST be verified on the Resend account, or every
# send is refused with 403 "domain is not verified" and no mail is delivered.
# meetifyy.app is the verified sending domain (SPF, DKIM and DMARC published).
# The driver checks this once at boot and logs `email.domain_unverified` if it
# is wrong, rather than failing one silent job at a time.
EMAIL_FROM=noreply@meetifyy.app          # [REQUIRED]
EMAIL_FROM_NAME=Meetifyy
RESEND_API_KEY=                          # [SECRET] required when driver=resend
# Legacy fallback for EMAIL_FROM. Prefer EMAIL_FROM.
RESEND_FROM_EMAIL=

# Must be an address that actually receives mail.
EMAIL_REPLY_TO=
# From header for security mail (admin OTP, password changes).
# (default: "<EMAIL_FROM_NAME> Security <EMAIL_FROM>")
EMAIL_SECURITY_FROM=

# SMTP is only consulted when EMAIL_DRIVER is mailpit or smtp.
# Brevo relay, used as the failover above. The From address must be a verified
# sender on the Brevo account or every send is rejected.
SMTP_HOST=                   # e.g. smtp-relay.brevo.com
SMTP_PORT=                   # 587 for STARTTLS (465 would use implicit TLS)
SMTP_USER=                   # [SECRET] Brevo login email
SMTP_PASS=                   # [SECRET] Brevo SMTP key, not the account password

# Local-development safety valve. Ignored in staging and production, which
# always mail the real recipient. Leave empty.
DEV_EMAIL_REDIRECT=


# ── Storage (Cloudflare R2) ──────────────────────────────────────────────────
STORAGE_PROVIDER=r2          # r2 is the only supported value
STORAGE_REGION=              # (default: auto)
STORAGE_SIGNED_URL_TTL=      # seconds (default: 3600)
STORAGE_PUBLIC_URL=https://cdn.meetifyy.app
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=            # [SECRET]
R2_SECRET_ACCESS_KEY=        # [SECRET]
R2_BUCKET_NAME=meetifyy-prod
R2_PUBLIC_URL=https://cdn.meetifyy.app


# ── Branding assets ──────────────────────────────────────────────────────────
# WORDMARK_URL is the only one of these that anything reads: BaseLayout.tsx
# renders it at the top of every backend email. Unset it falls back to
# `${FRONTEND_URL}/wordmark.png`, which the frontend does not actually ship —
# so in a deployed environment it has to name a real object.
WORDMARK_URL=

# The rest are wired through config/site.config.ts but referenced by no
# template or component. They are kept because the config surface is cheap and
# a future template may want them; setting them today uploads and serves files
# nothing will ever request. Leave them blank unless you are adding the
# template that uses them.
LOGO_URL=                    # unused
LOGO_ICON_URL=               # unused
LOGO_WHITE_URL=              # unused
ICON_INSTAGRAM_URL=          # unused
ICON_LINKEDIN_URL=           # unused
ICON_WEBSITE_URL=            # unused
ICON_SHIELD_URL=             # unused


# ── Site links shown in emails and notifications ─────────────────────────────
# Support page link shown in emails (default: ${FRONTEND_URL}/help-and-support).
SUPPORT_URL=

PRIVACY_PATH=                # (default: /privacy-policy)
TERMS_PATH=                  # (default: /terms-and-conditions)
INSTAGRAM_URL=               # (default: https://www.instagram.com/meetifyy.in?igsi=YzVoZ3drN29id2tn)
LINKEDIN_URL=                # (default: https://www.linkedin.com/company/meetifyy/)

PASSWORD_RESET_EXPIRY_MINUTES=   # (default: 10)
OTP_EXPIRY_MINUTES=              # (default: 10)


# ── Feature flags / logging ──────────────────────────────────────────────────
# The first three are forced off in production regardless of what is set here.
FEATURE_DEV_ENDPOINTS=
FEATURE_DEBUG_TOOLS=
FEATURE_RELAXED_RATE_LIMITS=
FEATURE_EXPERIMENTAL=            # (default: false)

# Shared secret for the /dev/email/* preview routes. Those routes are not
# registered in production at all; this is the second barrier that applies
# wherever they are. Blank means loopback-only access.
DEV_ENDPOINT_TOKEN=              # [SECRET]

LOG_LEVEL=                   # trace|debug|info|warn|error|fatal (default: info)
LOG_PRETTY=                  # (default: false in production — keep JSON logs)
LOG_QUERIES=                 # (default: false)


# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=                        # [SECRET]
SENTRY_TRACES_SAMPLE_RATE=         # (default: 0.1 in production)
SENTRY_PROFILES_SAMPLE_RATE=       # (default: 0.05 in production)


# ── Verification document storage ────────────────────────────────────────────
# Private bucket for account-verification uploads (selfie + college ID). It must
# NOT be the public CDN bucket: these are identity documents. Left blank it
# falls back to R2_BUCKET_NAME, which would publish them — set it explicitly
# once the private bucket exists.
R2_VERIFICATION_BUCKET_NAME=     # (default: falls back to R2_BUCKET_NAME)


# ── Support desk ─────────────────────────────────────────────────────────────
# Reply-To on outbound support mail. Blank uses the normal From address.
SUPPORT_REPLY_TO=                # (default: empty)

# Salt for the one-way hash of a submitter's IP. Blank falls back to
# SUPABASE_JWT_SECRET, then ADMIN_JWT_ACCESS_SECRET; the boot fails if none of
# the three is set. Set it only to rotate independently of those secrets.
SUPPORT_IP_HASH_SALT=            # [SECRET] (default: SUPABASE_JWT_SECRET)


# ── OTP hashing ──────────────────────────────────────────────────────────────
# Blank falls back to SUPABASE_SERVICE_ROLE_KEY, which is already required in
# production, so the hash is never unkeyed. Set it only to rotate OTP hashing
# independently of that key.
OTP_HASH_SECRET=                 # [SECRET] (default: SUPABASE_SERVICE_ROLE_KEY)


# ── Email transport ──────────────────────────────────────────────────────────
# Override only to point at a Resend-compatible mock. Leave blank in production.
RESEND_API_URL=                  # (default: https://api.resend.com)


# ── Admin analytics ──────────────────────────────────────────────────────────
# Route prefix the analytics dashboard is mounted under, and the limits it uses
# when probing upstreams and paging R2 object listings.
ANALYTICS_ADMIN_ROUTE_PREFIX=    # (default: /admin)
ANALYTICS_PROBE_TIMEOUT_MS=      # (default: 4000, min 250)
ANALYTICS_R2_MAX_LIST_PAGES=     # (default: 20, min 1, max 1000)


# ── Slow-request capture ─────────────────────────────────────────────────────
# On by default. Requests slower than the threshold are sampled, capped per
# minute, and pruned after the retention window.
SLOW_REQUEST_CAPTURE_ENABLED=    # (default: true)
SLOW_REQUEST_THRESHOLD_MS=       # (default: 500, min 1)
SLOW_REQUEST_RETENTION_DAYS=     # (default: 7, min 1, max 90)
SLOW_REQUEST_MAX_PER_MINUTE=     # (default: 120, min 1)
# Comma-separated. Setting this REPLACES the default list, it does not add to it.
SLOW_REQUEST_IGNORED_PREFIXES=   # (default: /admin/analytics,/health,/metrics,/favicon.ico)


# ── Infrastructure read-only credentials (admin status panel) ────────────────
# Optional throughout. They power the admin dashboard's live health tiles for
# Cloudflare, Vercel and Azure; with them blank those tiles simply report
# "not configured" and nothing else is affected. Every token here should be
# scoped READ-ONLY — the backend never mutates infrastructure through them.
CLOUDFLARE_API_TOKEN=            # [SECRET]
CLOUDFLARE_ACCOUNT_ID=           # (default: falls back to R2_ACCOUNT_ID)

VERCEL_TOKEN=                    # [SECRET]
VERCEL_TEAM_ID=

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=             # [SECRET]
AZURE_SUBSCRIPTION_ID=
