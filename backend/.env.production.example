# =============================================================================
# Backend — PRODUCTION environment template
# =============================================================================
# These values belong in the hosting platform's environment variable settings
# (Railway / Render / etc.), NOT in a committed file. This template exists so the
# full production set is reviewable; copy it into the platform's UI or secret
# store and fill in real values there.
#
# Only the values that DIFFER from the defaults are listed; see .env.example for
# the complete annotated list.
# =============================================================================

NODE_ENV=production
APP_ENV=production

FRONTEND_URL=https://meetifyy.app
BACKEND_URL=https://api.meetifyy.app
API_BASE_URL=
ADMIN_URL=https://admin.meetifyy.app

CORS_ORIGINS=https://meetifyy.app,https://www.meetifyy.app
CORS_ORIGIN_PATTERNS=
# Forced off in production regardless; listed for clarity.
CORS_ALLOW_LOCAL_NETWORK=false

CSP_ENABLED=true
HSTS_ENABLED=true
CSP_SCRIPT_SRC=
CSP_STYLE_SRC=https://fonts.googleapis.com
CSP_FONT_SRC=https://fonts.gstatic.com
CSP_IMG_SRC=https://images.unsplash.com,https://media.giphy.com
CSP_CONNECT_SRC=wss://api.meetifyy.app

COOKIE_DOMAIN=.meetifyy.app
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# PRODUCTION database. Must be a different database from development.
DATABASE_URL=
DIRECT_URL=
ALLOW_DESTRUCTIVE_SEED=false

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=
ADMIN_JWT_PENDING_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

REDIS_URL=

STORAGE_PROVIDER=r2
STORAGE_PUBLIC_URL=https://cdn.meetifyy.app
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=meetifyy-prod
R2_PUBLIC_URL=https://cdn.meetifyy.app

EMAIL_DRIVER=resend
RESEND_API_KEY=
# The domain here MUST be verified on the Resend account, or every send is
# refused with 403 "domain is not verified" and no mail is delivered.
# meetifyy.app is the verified sending domain (SPF, DKIM and DMARC published);
# meetifyy.com is not registered with Resend and must not be used.
EMAIL_FROM=noreply@meetifyy.app
EMAIL_FROM_NAME=Meetifyy
EMAIL_REPLY_TO=support@meetifyy.app
# Leave empty. Recipient redirection is ignored in staging and production
# anyway; it exists only for local development.
DEV_EMAIL_REDIRECT=

# Must be an address that actually receives mail: it is rendered as a
# clickable mailto in the login-alert and password-changed emails. Neither
# meetifyy.com nor meetifyy.app publishes an MX record today, so an address at
# either domain would bounce.
SUPPORT_EMAIL=
INSTAGRAM_URL=
TWITTER_URL=
LINKEDIN_URL=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05

FEATURE_DEV_ENDPOINTS=false
FEATURE_DEBUG_TOOLS=false
FEATURE_EXPERIMENTAL=false
LOG_LEVEL=info
LOG_PRETTY=false
LOG_QUERIES=false
