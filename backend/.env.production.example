# =============================================================================
# Backend — PRODUCTION environment template
# =============================================================================
# These values belong in the hosting platform's environment variable settings
# (Railway / Render / etc.), NOT in a committed file. This template exists so the
# full production set is reviewable; copy it into the platform's UI or secret
# store and fill in real values there.
#
# Only the values that DIFFER from the defaults are listed; see .env.example for
# the complete annotated list.
# =============================================================================

NODE_ENV=production
APP_ENV=production

FRONTEND_URL=https://meetifyy.com
BACKEND_URL=https://api.meetifyy.com
API_BASE_URL=https://api.meetifyy.com/api
ADMIN_URL=https://admin.meetifyy.com

CORS_ORIGINS=https://meetifyy.com,https://www.meetifyy.com
CORS_ORIGIN_PATTERNS=
# Forced off in production regardless; listed for clarity.
CORS_ALLOW_LOCAL_NETWORK=false

CSP_ENABLED=true
HSTS_ENABLED=true
CSP_SCRIPT_SRC=
CSP_STYLE_SRC=https://fonts.googleapis.com
CSP_FONT_SRC=https://fonts.gstatic.com
CSP_IMG_SRC=https://images.unsplash.com,https://media.giphy.com
CSP_CONNECT_SRC=wss://api.meetifyy.com

COOKIE_DOMAIN=.meetifyy.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# PRODUCTION database. Must be a different database from development.
DATABASE_URL=
DIRECT_URL=
ALLOW_DESTRUCTIVE_SEED=false

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=
ADMIN_JWT_PENDING_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

REDIS_URL=

STORAGE_PROVIDER=r2
STORAGE_PUBLIC_URL=https://cdn.meetifyy.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=meetifyy-prod
R2_PUBLIC_URL=https://cdn.meetifyy.com

EMAIL_DRIVER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@meetifyy.com
EMAIL_FROM_NAME=Meetifyy
EMAIL_REPLY_TO=support@meetifyy.com
DEV_EMAIL_REDIRECT=

SUPPORT_EMAIL=support@meetifyy.com
INSTAGRAM_URL=
TWITTER_URL=
LINKEDIN_URL=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05

FEATURE_DEV_ENDPOINTS=false
FEATURE_DEBUG_TOOLS=false
FEATURE_EXPERIMENTAL=false
LOG_LEVEL=info
LOG_PRETTY=false
LOG_QUERIES=false
